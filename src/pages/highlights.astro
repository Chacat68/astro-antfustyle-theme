---
import { getRelativeLocaleUrl } from 'astro:i18n'

import BaseLayout from '~/layouts/BaseLayout.astro'
import StandardLayout from '~/layouts/StandardLayout.astro'
import { getLocale, useTranslations } from '~/i18n/translate'

const locale = getLocale(Astro.currentLocale)
const t = useTranslations(locale)
const galleryUrl = getRelativeLocaleUrl(locale, 'gallery')

const page = {
  bgType: 'ambient' as const,
  ogImage: false,
}
---

<BaseLayout
  title={t('page.highlights.title')}
  description={t('page.highlights.description')}
  bgType={page.bgType}
  navRail="wide"
  ogImage={page.ogImage}
  noindex={true}
>
  <StandardLayout
    wide
    eyebrow="Highlights"
    title={t('page.highlights.title')}
    subtitle={t('page.highlights.subtitle')}
    isCentered={true}
  >
    <div class="studio-empty flex flex-col items-center gap-4 text-center">
      <p>{t('page.highlights.removed')}</p>
      <a
        class="rounded-full bg-[var(--c-accent)] px-5 py-2 text-[var(--c-bg)] op-transition hover:op-80"
        href={galleryUrl}
      >
        {t('page.gallery.title')}
      </a>
    </div>
  </StandardLayout>
</BaseLayout>
