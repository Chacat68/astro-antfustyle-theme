---
import BaseLayout from '~/layouts/BaseLayout.astro'
import Link from '~/components/base/Link.astro'
import { ensureTrailingSlash } from '~/utils/path'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { getLocale, useTranslations } from '~/i18n/translate'

const locale = getLocale(Astro.currentLocale)
const t = useTranslations(locale)
const homeHref = ensureTrailingSlash(getRelativeLocaleUrl(locale, ''))
---

<BaseLayout
  title="404"
  description={t('page.404.description')}
  bgType="ambient"
  ogImage={false}
  noindex={true}
>
  <div class="studio-page studio-page--center">
    <div class="studio-empty">
      <p class="page-eyebrow">
        <span class="page-eyebrow__dot" aria-hidden="true"></span>
        Error
      </p>
      <p class="studio-empty__code">404</p>
      <p class="studio-empty__message">{t('page.404.message')}</p>
      <Link class="studio-empty__action" href={homeHref}>
        {t('page.404.home')}
      </Link>
    </div>
  </div>
</BaseLayout>
