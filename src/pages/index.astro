---
import BaseLayout from '~/layouts/BaseLayout.astro'
import StudioHero from '~/components/home/StudioHero.astro'
import HomeAbout from '~/components/home/HomeAbout.astro'
import { getLocale, useTranslations } from '~/i18n/translate'

// 首页：Studio Hero + 关于我展示；Ambient 轻量背景衬托下方内容
const page = {
  bgType: 'ambient' as const,
  ogImage: false,
}

const locale = getLocale(Astro.currentLocale)
const t = useTranslations(locale)
---

<BaseLayout
  title={t('page.home.title')}
  description={t('page.home.description')}
  bgType={page.bgType}
  ogImage={page.ogImage}
  mainClass="home-main"
>
  <StudioHero />
  <HomeAbout />
</BaseLayout>
