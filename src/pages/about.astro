---
/**
 * 关于页：完整 Studio 排版（与首页 HomeAbout 同源视觉，内容更完整）
 */
import { Image } from 'astro:assets'
import BaseLayout from '~/layouts/BaseLayout.astro'
import Link from '~/components/base/Link.astro'
import ImageViewer from '~/components/widgets/ImageViewer.astro'
import { UI } from '~/config'
import { getLocale, useTranslations } from '~/i18n/translate'
import imgTime from '~/assets/about/DSC03299.webp'
import imgFree from '~/assets/about/DSC04066.webp'
import imgSimple from '~/assets/about/DSC03225.webp'

const page = {
  bgType: 'ambient' as const,
  ogImage: false,
}

const socialLabel = (title: string) => {
  if (title === 'Github') return 'GitHub'
  const onIndex = title.lastIndexOf(' on ')
  return onIndex >= 0 ? title.slice(onIndex + 4) : title
}

const locale = getLocale(Astro.currentLocale)
const t = useTranslations(locale)

const roles = [
  t('home.about.role.game'),
  t('home.about.role.create'),
  t('home.about.role.photo'),
  t('home.about.role.code'),
] as const

const historyItems = [
  t('about.history.item1'),
  t('about.history.item2'),
  t('about.history.item3'),
  t('about.history.item4'),
  t('about.history.item5'),
  t('about.history.item6'),
] as const

const simpleItems = [
  t('about.philosophy.simple.item1'),
  t('about.philosophy.simple.item2'),
  t('about.philosophy.simple.item3'),
] as const

const philosophySections = [
  {
    title: t('about.philosophy.time.title'),
    image: imgTime,
    alt: t('about.philosophy.time.imgAlt'),
    paragraphs: [
      t('about.philosophy.time.p1'),
      t('about.philosophy.time.p2'),
      t('about.philosophy.time.p3'),
    ],
  },
  {
    title: t('about.philosophy.free.title'),
    image: imgFree,
    alt: t('about.philosophy.free.imgAlt'),
    paragraphs: [
      t('about.philosophy.free.p1'),
      t('about.philosophy.free.p2'),
      t('about.philosophy.free.p3'),
    ],
  },
] as const
---

<BaseLayout
  title={t('page.about.title')}
  description={t('page.about.description')}
  bgType={page.bgType}
  ogImage={page.ogImage}
>
  <div class="about-page">
    <header class="about-page__intro">
      <p class="page-eyebrow">
        <span class="page-eyebrow__dot" aria-hidden="true"></span>
        {t('home.about.eyebrow')}
      </p>
      <h1 class="about-page__title">{t('home.about.title')}</h1>
      <div class="about-page__lead">
        <p>{t('home.intro1')}</p>
        <p>{t('home.intro2')}</p>
      </div>
      <ul class="about-page__roles" aria-label={t('home.about.rolesAria')}>
        {roles.map((role) => <li>{role}</li>)}
      </ul>
    </header>

    <section class="about-page__block" aria-labelledby="about-history">
      <p class="page-eyebrow">
        <span class="page-eyebrow__dot" aria-hidden="true"></span>
        {t('home.about.journeyEyebrow')}
      </p>
      <h2 class="about-page__heading" id="about-history">
        {t('about.history.title')}
      </h2>
      <ol class="about-page__history">
        {
          historyItems.map((item) => (
            <li class="about-page__history-item" set:html={item} />
          ))
        }
      </ol>
    </section>

    <section class="about-page__block" aria-labelledby="about-philosophy">
      <p class="page-eyebrow">
        <span class="page-eyebrow__dot" aria-hidden="true"></span>
        {t('home.about.philosophyEyebrow')}
      </p>
      <h2 class="about-page__heading" id="about-philosophy">
        {t('about.philosophy.title')}
      </h2>

      {
        philosophySections.map((section) => (
          <article class="about-page__pillar">
            <figure class="about-page__media">
              <Image
                src={section.image}
                alt={section.alt}
                widths={[640, 960, 1280]}
                sizes="(max-width: 768px) 100vw, 720px"
                loading="lazy"
              />
            </figure>
            <div class="about-page__pillar-copy">
              <h3>{section.title}</h3>
              {section.paragraphs.map((p) => (
                <p>{p}</p>
              ))}
            </div>
          </article>
        ))
      }

      <article class="about-page__pillar">
        <figure class="about-page__media">
          <Image
            src={imgSimple}
            alt={t('about.philosophy.simple.imgAlt')}
            widths={[640, 960, 1280]}
            sizes="(max-width: 768px) 100vw, 720px"
            loading="lazy"
          />
        </figure>
        <div class="about-page__pillar-copy">
          <h3>{t('about.philosophy.simple.title')}</h3>
          <p>{t('about.philosophy.simple.p1')}</p>
          <p>{t('about.philosophy.simple.lead')}</p>
          <ul>
            {simpleItems.map((item) => <li set:html={item} />)}
          </ul>
          <p>{t('about.philosophy.simple.p2')}</p>
        </div>
      </article>
    </section>

    <section class="about-page__cta" aria-labelledby="about-contact">
      <div class="about-page__cta-copy">
        <p class="page-eyebrow page-eyebrow--on-dark">
          <span class="page-eyebrow__dot" aria-hidden="true"></span>
          {t('home.about.contactEyebrow')}
        </p>
        <h2 class="about-page__cta-title" id="about-contact">
          {t('about.contact.title')}
        </h2>
        <p>{t('about.contact.p1')}</p>
        <p>{t('about.contact.p2')}</p>
      </div>
      <div class="about-page__cta-actions">
        <a class="about-page__mail" href="mailto:chawf56@outlook.com">
          chawf56@outlook.com
        </a>
        <div class="about-page__socials">
          <span class="about-page__socials-label">{t('home.findMeOn')}</span>
          {
            UI.socialLinks.map((item) => (
              <Link
                href={item.link}
                title={item.title}
                class="about-page__social"
                aria-label={socialLabel(item.title)}
                external
              >
                {'icon' in item && (
                  <span class={item.icon} aria-hidden="true" />
                )}
                <span>{socialLabel(item.title)}</span>
              </Link>
            ))
          }
        </div>
      </div>
    </section>
  </div>
  <ImageViewer selector=".about-page" options={{ title: 0, navbar: 0 }} />
</BaseLayout>

<style>
  .about-page {
    width: min(100%, 48rem);
    margin-inline: auto;
    display: grid;
    gap: 3.5rem;
    padding-bottom: 2rem;
  }

  .about-page__intro,
  .about-page__block {
    display: grid;
    gap: 1rem;
  }

  .about-page__title {
    margin: 0;
    font-size: clamp(2rem, 4.5vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .about-page__lead {
    display: grid;
    gap: 0.85rem;
    color: var(--c-muted);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .about-page__lead p {
    margin: 0;
  }

  .about-page__roles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.1rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.92rem;
    font-weight: 500;
  }

  .about-page__roles li:not(:last-child)::after {
    content: '·';
    margin-inline-start: 1.1rem;
    color: var(--c-muted);
  }

  .about-page__heading {
    margin: 0;
    font-size: clamp(1.45rem, 2.5vw, 1.85rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .about-page__history {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--c-border);
  }

  .about-page__history-item {
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--c-border);
    color: var(--c-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .about-page__history-item :global(strong) {
    display: inline-block;
    min-width: 6.5rem;
    margin-inline-end: 0.65rem;
    color: var(--c-text);
    font-weight: 600;
  }

  .about-page__pillar {
    display: grid;
    gap: 1.25rem;
    margin-top: 1.25rem;
  }

  .about-page__media {
    margin: 0;
    overflow: hidden;
    border-radius: var(--c-radius-lg);
    aspect-ratio: 16 / 10;
    background: var(--c-hero-bg);
    box-shadow: var(--c-shadow);
  }

  .about-page__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .about-page__pillar-copy {
    display: grid;
    gap: 0.75rem;
  }

  .about-page__pillar-copy h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .about-page__pillar-copy p,
  .about-page__pillar-copy li {
    margin: 0;
    color: var(--c-muted);
    font-size: 0.98rem;
    line-height: 1.7;
  }

  .about-page__pillar-copy ul {
    margin: 0;
    padding-inline-start: 1.1rem;
    display: grid;
    gap: 0.4rem;
  }

  .about-page__pillar-copy :global(strong) {
    color: var(--c-text);
  }

  .page-eyebrow--on-dark {
    color: rgba(250, 250, 250, 0.72);
  }

  .about-page__cta {
    display: grid;
    gap: 1.5rem;
    padding: 2rem 1.5rem;
    border-radius: 2rem;
    background: var(--c-nav-bg);
    color: var(--c-nav-fg);
    box-shadow: var(--c-shadow);
  }

  .about-page__cta-copy {
    display: grid;
    gap: 0.75rem;
  }

  .about-page__cta-title {
    margin: 0;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .about-page__cta-copy p {
    margin: 0;
    color: color-mix(in srgb, var(--c-nav-fg) 74%, transparent);
    font-size: 0.98rem;
    line-height: 1.65;
  }

  .about-page__cta-actions {
    display: grid;
    gap: 1rem;
  }

  .about-page__mail {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 2.6rem;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    background: var(--c-nav-fg);
    color: var(--c-nav-bg) !important;
    opacity: 1 !important;
    font-weight: 500;
    text-decoration: none;
  }

  .about-page__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    align-items: center;
  }

  .about-page__socials-label {
    width: 100%;
    color: color-mix(in srgb, var(--c-nav-fg) 55%, transparent);
    font-size: 0.8rem;
    letter-spacing: 0.04em;
  }

  .about-page__social {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.2rem;
    padding: 0.35rem 0.75rem;
    border: 1px solid color-mix(in srgb, var(--c-nav-fg) 24%, transparent);
    border-radius: 999px;
    color: color-mix(in srgb, var(--c-nav-fg) 88%, transparent) !important;
    opacity: 1 !important;
    font-size: 0.85rem;
    text-decoration: none;
  }

  .about-page__social:hover,
  .about-page__social:focus-visible {
    background: color-mix(in srgb, var(--c-nav-fg) 10%, transparent);
    color: var(--c-nav-fg) !important;
    outline: none;
  }

  @media (min-width: 768px) {
    .about-page {
      gap: 4.25rem;
    }

    .about-page__pillar {
      grid-template-columns: 1.05fr 1fr;
      align-items: center;
      gap: 1.75rem;
    }

    .about-page__pillar:nth-of-type(even) .about-page__media {
      order: 2;
    }
  }
</style>
