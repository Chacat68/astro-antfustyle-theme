---
import { getLocale, useTranslations } from '~/i18n/translate'

const locale = getLocale(Astro.currentLocale)
const t = useTranslations(locale)
---

<button
  id="nav-open-button"
  class="touch-target hidden! lt-lg:inline-flex! op-60 hover:op-100 op-transition"
  title={t('a11y.navigation')}
  aria-label={t('a11y.navigation')}
  aria-expanded="false"
  aria-controls="nav-panel"
>
  <div u-i-ri-menu-line></div>
</button>

<div
  id="nav-panel"
  class="hidden! z-200 fixed top-50vh left-50vw translate-x--50% translate-y--50%
    overflow-y-auto flex-col gap-5
    w-90% max-w-md max-h-80vh py-5 px-6 rounded-3xl border"
>
  <ul class="nav-panel__list">
    <slot name="text" />
  </ul>
  <div class="nav-panel__icons flex justify-center items-center gap-4">
    <slot name="icon" />
  </div>
</div>

<style is:global>
  /* 面板在 .site-nav__shell 内，须重置胶囊导航色，否则暗色主题会变成深字深底 */
  #nav-panel {
    display: flex;
    max-height: min(80vh, calc(100dvh - 2rem));
    color: var(--c-text);
    border-color: var(--c-border);
    background: var(--c-bg);
    box-shadow: var(--c-shadow-hover);
  }

  #nav-panel .nav-panel__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #nav-panel .nav-panel__list li {
    border-color: var(--c-border) !important;
  }

  #nav-panel a,
  #nav-panel button {
    color: var(--c-text) !important;
    opacity: 1 !important;
    background: transparent !important;
    box-shadow: none !important;
    transform: none !important;
    border-radius: 0.65rem;
  }

  #nav-panel a:hover,
  #nav-panel a:focus-visible,
  #nav-panel button:hover,
  #nav-panel button:focus-visible {
    color: var(--c-text) !important;
    background: var(--c-surface-hover) !important;
  }

  #nav-panel a[aria-current='page'] {
    color: var(--c-text) !important;
    background: var(--c-accent-soft) !important;
    font-weight: 600;
  }

  #nav-panel .nav-panel__icons a,
  #nav-panel .nav-panel__icons button {
    border-radius: 999px;
  }
</style>

<script>
  import { toggleFadeEffect } from '~/utils/misc'

  document.addEventListener('astro:page-load', () => {
    const navOpenButton = document.getElementById('nav-open-button')
    const navPanel = document.getElementById('nav-panel')

    const setExpanded = (expanded: boolean) => {
      navOpenButton?.setAttribute('aria-expanded', expanded ? 'true' : 'false')
    }

    const isNavPanelOpen = () => {
      return navPanel ? !navPanel.classList.contains('hidden!') : false
    }

    const openNavPanel = () => {
      toggleFadeEffect('backdrop', true, 'hidden')
      toggleFadeEffect('nav-panel', true, 'hidden!')
      setExpanded(true)
    }

    const closeNavPanel = () => {
      toggleFadeEffect('nav-panel', false, 'hidden!')
      toggleFadeEffect('backdrop', false, 'hidden')
      setExpanded(false)
    }

    const handleBtnClickToToggle = () => {
      if (isNavPanelOpen()) {
        closeNavPanel()
        return
      }

      openNavPanel()
    }

    navOpenButton?.addEventListener('click', handleBtnClickToToggle)
  })
</script>
