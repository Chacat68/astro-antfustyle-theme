---
import LogoButton from '~/components/widgets/LogoButton.astro'
import LanguageSwitch from '~/components/widgets/LanguageSwitch.astro'
import RssLink from '~/components/widgets/RssLink.astro'
import NavItem from '~/components/nav/NavItem.astro'
import NavSwitch from '~/components/nav/NavSwitch.astro'
import NavBarSlot from '~/components/nav/NavBarSlot.astro'

import { UI } from '~/config'
import { getLocale, useTranslations } from '~/i18n/translate'

const { navBarLayout, internalNavs, socialLinks } = UI
const { left, right, mergeOnMobile } = navBarLayout
const showSocialInNav =
  left.includes('socialLinks') || right.includes('socialLinks')

const locale = getLocale(Astro.currentLocale)
const t = useTranslations(locale)

const navKeyByPath: Record<string, string> = {
  '/blog': 'nav.blog',
  '/projects': 'nav.projects',
  '/friends': 'nav.friends',
  '/photos': 'nav.photos',
  '/gallery': 'nav.gallery',
  '/changelog': 'nav.changelog',
  '/about': 'nav.about',
}

const localizedInternalNavs = internalNavs.map((item) => {
  const key = navKeyByPath[item.path.replace(/\/+$/, '')]
  if (!key) return item
  return 'text' in item
    ? { ...item, title: t(key), text: t(key) }
    : { ...item, title: t(key) }
})

for (const item of new Set(left)) {
  if (new Set(right).has(item)) {
    throw new Error(
      `Duplicate '${item}' found in both 'UI.navBarLayout.left' and 'UI.navBarLayout.right'.`
    )
  }
}
---

<header class="site-nav" transition:name="site-nav">
  <div
    class:list={[
      'site-nav__shell',
      mergeOnMobile ? 'lt-lg:gap-2' : 'lt-md:gap-2',
    ]}
    transition:name="site-nav-shell"
  >
    <LogoButton />
    <nav
      class:list={[
        'flex items-center gap-3 w-full min-w-0',
        mergeOnMobile ? 'lt-lg:justify-end' : 'lt-md:justify-end',
        left.length !== 0
          ? right.length !== 0
            ? 'justify-between'
            : ''
          : 'justify-end',
      ]}
      aria-label={t('a11y.mainMenu')}
    >
      {
        left.length !== 0 && (
          <div
            class:list={[
              'flex items-center gap-3 print:op-0',
              mergeOnMobile ? 'lt-lg:gap-2' : 'lt-md:gap-2',
            ]}
          >
            <NavBarSlot
              keys={left}
              {mergeOnMobile}
              internalNavs={localizedInternalNavs}
              {socialLinks}
            />
          </div>
        )
      }
      {
        right.length !== 0 && (
          <div
            class:list={[
              'flex items-center gap-3 print:op-0',
              !right.includes('themeButton') &&
                !right.includes('searchButton') &&
                (mergeOnMobile ? 'lt-lg:hidden' : 'lt-md:hidden'),
              mergeOnMobile ? 'lt-lg:gap-2' : 'lt-md:gap-2',
            ]}
          >
            <NavBarSlot
              keys={right}
              {mergeOnMobile}
              internalNavs={localizedInternalNavs}
              {socialLinks}
            />
          </div>
        )
      }
      {
        mergeOnMobile && (
          <NavSwitch>
            <Fragment slot="text">
              {localizedInternalNavs.length !== 0 &&
                localizedInternalNavs.map((item) => (
                  <NavItem
                    type="internal"
                    {item}
                    {mergeOnMobile}
                    mobileItemType="text"
                  />
                ))}
              {showSocialInNav &&
                socialLinks.length !== 0 &&
                socialLinks.map((item) => (
                  <NavItem
                    type="social"
                    {item}
                    {mergeOnMobile}
                    mobileItemType="text"
                  />
                ))}
            </Fragment>
            <Fragment slot="icon">
              {localizedInternalNavs.length !== 0 &&
                localizedInternalNavs.map((item) => (
                  <NavItem
                    type="internal"
                    {item}
                    {mergeOnMobile}
                    mobileItemType="icon"
                  />
                ))}
              {showSocialInNav &&
                socialLinks.length !== 0 &&
                socialLinks.map((item) => (
                  <NavItem
                    type="social"
                    {item}
                    {mergeOnMobile}
                    mobileItemType="icon"
                  />
                ))}
              <LanguageSwitch />
              <RssLink class="op-50!" />
            </Fragment>
          </NavSwitch>
        )
      }
    </nav>
  </div>
</header>
