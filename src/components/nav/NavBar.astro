---
import LogoButton from '~/components/widgets/LogoButton.astro'
import LanguageSwitch from '~/components/widgets/LanguageSwitch.astro'
import RssLink from '~/components/widgets/RssLink.astro'
import NavItem from '~/components/nav/NavItem.astro'
import NavSwitch from '~/components/nav/NavSwitch.astro'
import NavBarSlot from '~/components/nav/NavBarSlot.astro'

import { UI } from '~/config'
import { getLocale, useTranslations } from '~/i18n/translate'

const { navBarLayout, internalNavs, socialLinks } = UI
const { left, right, mergeOnMobile } = navBarLayout
const showSocialInNav =
  left.includes('socialLinks') || right.includes('socialLinks')

const locale = getLocale(Astro.currentLocale)
const t = useTranslations(locale)

const navKeyByPath: Record<string, string> = {
  '/blog': 'nav.blog',
  '/projects': 'nav.projects',
  '/friends': 'nav.friends',
  '/photos': 'nav.photos',
  '/gallery': 'nav.gallery',
  '/changelog': 'nav.changelog',
  '/about': 'nav.about',
}

const localizedInternalNavs = internalNavs.map((item) => {
  const key = navKeyByPath[item.path.replace(/\/+$/, '')]
  if (!key) return item
  return 'text' in item
    ? { ...item, title: t(key), text: t(key) }
    : { ...item, title: t(key) }
})

for (const item of new Set(left)) {
  if (new Set(right).has(item)) {
    throw new Error(
      `Duplicate '${item}' found in both 'UI.navBarLayout.left' and 'UI.navBarLayout.right'.`
    )
  }
}
---

<header
  class={`site-nav site-nav-shell flex items-center gap-6 pt-[1.75rem] pb-[2rem] lt-lg:(pt-4 pb-5) ${mergeOnMobile ? 'lt-lg:gap-2.5' : 'lt-md:gap-3'} lt-sm:gap-2`}
>
  <LogoButton />
  <nav
    class={`site-nav__menu flex items-center gap-4.8 w-full min-w-0 ${mergeOnMobile ? 'lt-lg:(justify-end gap-2.5)' : 'lt-md:(justify-end gap-2.5)'} lt-sm:gap-2
    ${left.length !== 0 ? (right.length !== 0 ? 'justify-between' : '') : 'justify-end'}`}
    aria-label={t('a11y.mainMenu')}
  >
    {
      left.length !== 0 && (
        <div
          class:list={[
            'site-nav__group flex items-center gap-4.8 print:op-0',
            mergeOnMobile ? 'lt-lg:gap-2.5 lt-sm:gap-2' : 'lt-md:(gap-3)',
          ]}
        >
          <NavBarSlot
            keys={left}
            {mergeOnMobile}
            internalNavs={localizedInternalNavs}
            {socialLinks}
          />
        </div>
      )
    }
    {
      right.length !== 0 && (
        <div
          class:list={[
            'site-nav__group flex items-center gap-4.8 print:op-0',
            !right.includes('themeButton') &&
              !right.includes('searchButton') &&
              (mergeOnMobile ? 'lt-lg:hidden' : 'lt-md:hidden'),
            mergeOnMobile ? 'lt-lg:gap-2.5 lt-sm:gap-2' : 'lt-md:(gap-3)',
          ]}
        >
          <NavBarSlot
            keys={right}
            {mergeOnMobile}
            internalNavs={localizedInternalNavs}
            {socialLinks}
          />
        </div>
      )
    }
    {
      mergeOnMobile && (
        <NavSwitch>
          <Fragment slot="text">
            {localizedInternalNavs.length !== 0 &&
              localizedInternalNavs.map((item) => (
                <NavItem
                  type="internal"
                  {item}
                  {mergeOnMobile}
                  mobileItemType="text"
                />
              ))}
            {showSocialInNav &&
              socialLinks.length !== 0 &&
              socialLinks.map((item) => (
                <NavItem
                  type="social"
                  {item}
                  {mergeOnMobile}
                  mobileItemType="text"
                />
              ))}
          </Fragment>
          <Fragment slot="icon">
            {localizedInternalNavs.length !== 0 &&
              localizedInternalNavs.map((item) => (
                <NavItem
                  type="internal"
                  {item}
                  {mergeOnMobile}
                  mobileItemType="icon"
                />
              ))}
            {showSocialInNav &&
              socialLinks.length !== 0 &&
              socialLinks.map((item) => (
                <NavItem
                  type="social"
                  {item}
                  {mergeOnMobile}
                  mobileItemType="icon"
                />
              ))}
            <LanguageSwitch />
            <RssLink class="op-50!" />
          </Fragment>
        </NavSwitch>
      )
    }
  </nav>
</header>

<style>
  /*
   * 导航骨架使用显式 CSS，避免动态 class 组合在部分构建中漏掉
   * gap / padding，导致所有链接紧贴。折叠点与 lgp 内容宽度一致。
   */
  .site-nav-shell {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.75rem);
    min-height: 5rem;
    padding-top: 1.25rem;
    padding-bottom: 1.45rem;
  }

  .site-nav__menu {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 1rem;
    width: 100%;
    min-width: 0;
  }

  .site-nav__group {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 1.4vw, 1.25rem);
    min-width: 0;
  }

  @media (max-width: 1127.9px) {
    .site-nav-shell {
      gap: 0.75rem;
      min-height: 4.25rem;
      padding-top: 0.8rem;
      padding-bottom: 1rem;
    }

    .site-nav__menu {
      gap: 0.35rem;
    }

    .site-nav__group {
      gap: 0.2rem;
    }

    :global(.nav-item--desktop),
    :global(.nav-compact-hide) {
      display: none !important;
    }

    :global(#nav-open-button) {
      display: inline-flex !important;
    }
  }

  @media (max-width: 639.9px) {
    .site-nav-shell {
      gap: 0.4rem;
      min-height: 3.75rem;
      padding-top: 0.55rem;
      padding-bottom: 0.75rem;
    }

    .site-nav__menu,
    .site-nav__group {
      gap: 0.05rem;
    }
  }
</style>
