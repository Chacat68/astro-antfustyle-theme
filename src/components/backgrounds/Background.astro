---
import Ambient from '~/components/backgrounds/Ambient.astro'

import type { BgType } from '~/types'

interface Props {
  type: BgType
}

const { type } = Astro.props
---

{
  /* 全站统一轻量氛围背景；旧 bgType 值均映射到 Ambient 以兼容 frontmatter */
  (type === 'glitch' ||
    type === 'plum' ||
    type === 'dot' ||
    type === 'rose' ||
    type === 'particle' ||
    type === 'wave' ||
    type === 'constellation') && <Ambient />
}
