---
import Ambient from '~/components/backgrounds/Ambient.astro'

import type { BgType } from '~/types'

interface Props {
  type: BgType
}

const { type } = Astro.props

const useAmbient =
  type === 'ambient' ||
  type === 'glitch' ||
  type === 'plum' ||
  type === 'dot' ||
  type === 'rose' ||
  type === 'particle' ||
  type === 'wave' ||
  type === 'constellation'
---

{useAmbient && <Ambient />}
