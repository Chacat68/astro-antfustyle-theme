---
/**
 * 首页工作室 Hero（视觉参考 Zypher Agency）
 * 大圆角舞台 + 氛围底图 + 品牌标题 + 入口 CTA；工具栏由顶栏胶囊导航承接
 */
import Link from '~/components/base/Link.astro'
import { UI, SITE } from '~/config'
import { ensureTrailingSlash } from '~/utils/path'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { getLocale, useTranslations } from '~/i18n/translate'

const locale = getLocale(Astro.currentLocale)
const t = useTranslations(locale)

const navKeyByPath: Record<string, string> = {
  '/blog': 'nav.blog',
  '/projects': 'nav.projects',
  '/friends': 'nav.friends',
  '/photos': 'nav.photos',
  '/gallery': 'nav.gallery',
}

const portals = [
  {
    href: ensureTrailingSlash(getRelativeLocaleUrl(locale, 'about')),
    label: t('nav.about'),
  },
  ...UI.internalNavs
    .filter((item) => {
      const path = item.path.replace(/\/+$/, '')
      return path !== '/changelog' && path !== '/friends'
    })
    .slice(0, 4)
    .map((item) => {
      const path = item.path.replace(/\/+$/, '')
      const key = navKeyByPath[path]
      return {
        href: ensureTrailingSlash(
          getRelativeLocaleUrl(locale, path.replace(/^\//, ''))
        ),
        label: key ? t(key) : item.title,
      }
    }),
]
---

<section
  class="studio-hero"
  id="studio-hero"
  data-studio-hero
  aria-label={t('home.studio.aria')}
>
  <div class="studio-hero__stage">
    <div class="studio-hero__visual" aria-hidden="true">
      <div class="studio-hero__mist"></div>
      <div class="studio-hero__streak"></div>
      <div class="studio-hero__grain"></div>
      <div class="studio-hero__shade"></div>
    </div>

    <span class="studio-hero__corner studio-hero__corner--tl" aria-hidden="true"
    ></span>
    <span class="studio-hero__corner studio-hero__corner--tr" aria-hidden="true"
    ></span>
    <span class="studio-hero__corner studio-hero__corner--bl" aria-hidden="true"
    ></span>
    <span class="studio-hero__corner studio-hero__corner--br" aria-hidden="true"
    ></span>

    <div class="studio-hero__content">
      <div class="studio-hero__copy">
        <p class="studio-hero__eyebrow">
          <span class="studio-hero__dot" aria-hidden="true"></span>
          <span>{t('home.studio.eyebrow')}</span>
        </p>
        <h1 class="studio-hero__brand">
          {SITE.title}<sup class="studio-hero__sup" aria-hidden="true">®</sup>
        </h1>
        <p class="studio-hero__title">{t('home.studio.headline')}</p>
      </div>

      <div class="studio-hero__aside">
        <p class="studio-hero__desc">{t('home.studio.description')}</p>
        <nav class="studio-hero__ctas" aria-label={t('home.studio.portalsAria')}>
          {
            portals.map((item, index) => (
              <Link
                href={item.href}
                class:list={[
                  'studio-hero__cta',
                  index === 0 && 'studio-hero__cta--primary',
                ]}
              >
                {item.label}
              </Link>
            ))
          }
        </nav>
        <div class="studio-hero__trust">
          <span>{t('home.studio.trust')}</span>
          <div class="studio-hero__socials">
            {
              UI.socialLinks.slice(0, 3).map((item) => (
                <Link
                  href={item.link}
                  title={item.title}
                  class="studio-hero__social"
                  aria-label={item.title}
                  external
                >
                  {'icon' in item && (
                    <span class={item.icon} aria-hidden="true" />
                  )}
                </Link>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .studio-hero {
    --sh-fg: #fafafa;
    --sh-muted: rgba(250, 250, 250, 0.78);

    width: 100%;
    padding: 0.25rem 1rem 1.25rem;
  }

  .studio-hero__stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: min(72svh, 44rem);
    max-width: 90rem;
    margin-inline: auto;
    border-radius: 2.5rem;
    background: var(--c-hero-bg, #b7bdc1);
    box-shadow: var(--c-shadow);
    color: var(--sh-fg);
  }

  .studio-hero__visual {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .studio-hero__mist {
    position: absolute;
    inset: -10%;
    background:
      radial-gradient(
        55% 50% at 68% 42%,
        rgba(255, 214, 210, 0.55),
        transparent 62%
      ),
      radial-gradient(
        45% 40% at 30% 55%,
        rgba(210, 230, 235, 0.5),
        transparent 70%
      ),
      linear-gradient(135deg, #c8ced3 0%, #aeb6bc 42%, #d5d0cb 100%);
    transform: scale(1.04);
    animation: studio-drift 18s var(--ease-out) infinite alternate;
  }

  :global(.dark) .studio-hero__mist {
    background:
      radial-gradient(
        55% 50% at 68% 42%,
        rgba(255, 170, 160, 0.28),
        transparent 62%
      ),
      radial-gradient(
        45% 40% at 30% 55%,
        rgba(140, 190, 205, 0.28),
        transparent 70%
      ),
      linear-gradient(135deg, #3a3f46 0%, #2a2d31 48%, #3d3834 100%);
  }

  :global(.dark) .studio-hero__shade {
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.28) 0%,
      transparent 40%,
      rgba(0, 0, 0, 0.5) 100%
    );
  }

  .studio-hero__streak {
    position: absolute;
    inset: 18% -20% auto;
    height: 28%;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.08) 28%,
      rgba(255, 196, 188, 0.55) 48%,
      rgba(255, 255, 255, 0.7) 52%,
      rgba(210, 235, 240, 0.4) 62%,
      transparent 100%
    );
    filter: blur(18px);
    mix-blend-mode: screen;
    transform: rotate(-8deg) translateX(-8%);
    animation: studio-streak 9s var(--ease-out) infinite alternate;
  }

  .studio-hero__grain {
    position: absolute;
    inset: 0;
    opacity: 0.28;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.55'/%3E%3C/svg%3E");
    background-size: 180px 180px;
    pointer-events: none;
  }

  .studio-hero__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.18) 0%,
      transparent 38%,
      rgba(0, 0, 0, 0.35) 100%
    );
    pointer-events: none;
  }

  .studio-hero__corner {
    position: absolute;
    z-index: 2;
    width: 1.25rem;
    height: 1.25rem;
    border-color: rgba(255, 255, 255, 0.4);
    border-style: solid;
    pointer-events: none;
  }

  .studio-hero__corner--tl {
    top: 1.5rem;
    left: 1.5rem;
    border-width: 1px 0 0 1px;
    border-top-left-radius: 0.35rem;
  }

  .studio-hero__corner--tr {
    top: 1.5rem;
    right: 1.5rem;
    border-width: 1px 1px 0 0;
    border-top-right-radius: 0.35rem;
  }

  .studio-hero__corner--bl {
    bottom: 1.5rem;
    left: 1.5rem;
    border-width: 0 0 1px 1px;
    border-bottom-left-radius: 0.35rem;
  }

  .studio-hero__corner--br {
    right: 1.5rem;
    bottom: 1.5rem;
    border-width: 0 1px 1px 0;
    border-bottom-right-radius: 0.35rem;
  }

  .studio-hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 2.5rem;
    min-height: inherit;
    padding: 3.5rem 2rem 2.25rem;
  }

  .studio-hero__copy {
    max-width: 40rem;
    padding-top: 2.5rem;
  }

  .studio-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    color: var(--sh-muted);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .studio-hero__dot {
    width: 0.375rem;
    height: 0.375rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.8);
  }

  .studio-hero__brand {
    margin: 1rem 0 0;
    font-size: clamp(2.75rem, 8vw, 5.5rem);
    font-weight: 600;
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: #fff;
  }

  .studio-hero__sup {
    margin-inline-start: 0.15em;
    font-size: 0.35em;
    font-weight: 500;
    opacity: 0.45;
    vertical-align: super;
  }

  .studio-hero__title {
    margin: 1rem 0 0;
    max-width: 18ch;
    font-size: clamp(1.35rem, 3.2vw, 2.15rem);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: rgba(255, 255, 255, 0.92);
  }

  .studio-hero__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-top: auto;
    max-width: 28rem;
  }

  .studio-hero__desc {
    margin: 0;
    color: var(--sh-muted);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  .studio-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .studio-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.5rem;
    padding: 0.55rem 1.1rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: #fff !important;
    opacity: 1 !important;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    text-decoration: none;
    backdrop-filter: blur(8px);
    transition:
      transform var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .studio-hero__cta--primary {
    background: rgba(255, 255, 255, 0.94);
    border-color: transparent;
    color: #0a0a0a !important;
  }

  .studio-hero__cta:hover,
  .studio-hero__cta:focus-visible {
    transform: translateY(-2px);
    background: rgba(255, 255, 255, 0.16);
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.18);
    outline: none;
  }

  .studio-hero__cta--primary:hover,
  .studio-hero__cta--primary:focus-visible {
    background: #fff;
  }

  .studio-hero__trust {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
    margin-top: 0.35rem;
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.875rem;
  }

  .studio-hero__socials {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .studio-hero__social {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 999px;
    color: rgba(255, 255, 255, 0.85) !important;
    opacity: 1 !important;
    font-size: 0.95rem;
    transition:
      background-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .studio-hero__social:hover,
  .studio-hero__social:focus-visible {
    background: rgba(255, 255, 255, 0.12);
    color: #fff !important;
    outline: none;
  }

  @keyframes studio-drift {
    from {
      transform: scale(1.02) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.08) translate3d(-2%, 1.5%, 0);
    }
  }

  @keyframes studio-streak {
    from {
      transform: rotate(-8deg) translateX(-10%);
      opacity: 0.7;
    }
    to {
      transform: rotate(-6deg) translateX(8%);
      opacity: 1;
    }
  }

  @media (min-width: 768px) {
    .studio-hero {
      padding: 1rem 1rem 1.75rem;
    }

    .studio-hero__stage {
      min-height: min(78svh, 48rem);
    }

    .studio-hero__content {
      grid-template-rows: 1fr auto;
      gap: 3rem;
      padding: 3.5rem 3.5rem 2.75rem;
    }

    .studio-hero__copy {
      padding-top: 4.5rem;
    }

    .studio-hero__aside {
      margin-inline-start: auto;
      align-items: flex-end;
      text-align: right;
    }

    .studio-hero__ctas {
      justify-content: flex-end;
    }

    .studio-hero__trust {
      justify-content: flex-end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .studio-hero__mist,
    .studio-hero__streak {
      animation: none;
    }

    .studio-hero__cta:hover,
    .studio-hero__cta:focus-visible {
      transform: none;
    }
  }
</style>
