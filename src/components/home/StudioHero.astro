---
/**
 * 首页工作室 Hero（视觉参考 Zypher Agency）
 * 大圆角纯影像舞台 + 核心主题（无赛博角标）；页面入口统一由顶栏承接
 */
import { getLocale, useTranslations } from '~/i18n/translate'

const locale = getLocale(Astro.currentLocale)
const t = useTranslations(locale)
const heroImage =
  'https://blog-1259751088.cos.ap-shanghai.myqcloud.com/20260102174815976.webp?imageSlim'
---

<section
  class="studio-hero"
  id="studio-hero"
  data-studio-hero
  aria-label={t('home.studio.aria')}
>
  <div class="studio-hero__stage">
    <div class="studio-hero__visual" aria-hidden="true">
      <img
        class="studio-hero__photo"
        src={heroImage}
        alt=""
        width="1086"
        height="724"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <div class="studio-hero__grain"></div>
      <div class="studio-hero__shade"></div>
    </div>

    <div class="studio-hero__content">
      <div class="studio-hero__copy">
        <h1 class="studio-hero__title">{t('home.studio.headline')}</h1>
      </div>

      <div class="studio-hero__aside">
        <p class="studio-hero__desc">{t('home.studio.description')}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .studio-hero {
    --sh-fg: #fafafa;

    width: 100%;
    /* 顶距由首页导航视觉间距承担（约 18.4px，与胶囊上边对称）；底距交给 HomeAbout */
    padding: 0 var(--c-rail-pad, 1.25rem);
  }

  .studio-hero__stage {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(34rem, 72svh, 43rem);
    max-width: var(--c-hero-max, 90rem);
    margin-inline: auto;
    border: 0;
    border-radius: 2rem;
    background: var(--c-hero-bg, #b7bdc1);
    box-shadow: 0 32px 80px -44px rgba(0, 0, 0, 0.7);
    color: var(--sh-fg);
  }

  .studio-hero__visual {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
  }

  .studio-hero__photo {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 46%;
    filter: saturate(0.88) contrast(1.04);
    transform: scale(1.025);
    animation: studio-drift 22s var(--ease-out) infinite alternate;
  }

  .studio-hero__grain {
    position: absolute;
    inset: 0;
    opacity: 0.13;
    mix-blend-mode: overlay;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.55'/%3E%3C/svg%3E");
    background-size: 180px 180px;
    pointer-events: none;
  }

  .studio-hero__shade {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 14% 16%, rgba(3, 7, 12, 0.44), transparent 42%),
      radial-gradient(circle at 18% 78%, rgba(3, 7, 12, 0.3), transparent 46%),
      linear-gradient(
        180deg,
        rgba(2, 6, 10, 0.52) 0%,
        rgba(2, 6, 10, 0.08) 42%,
        rgba(2, 6, 10, 0.58) 100%
      );
    pointer-events: none;
  }

  :global(.dark) .studio-hero__shade {
    background:
      radial-gradient(circle at 14% 16%, rgba(0, 0, 0, 0.52), transparent 44%),
      radial-gradient(circle at 18% 78%, rgba(0, 0, 0, 0.36), transparent 48%),
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.56) 0%,
        rgba(0, 0, 0, 0.1) 42%,
        rgba(0, 0, 0, 0.68) 100%
      );
  }

  .studio-hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 1.5rem;
    min-height: inherit;
    padding: 1.65rem 1.5rem 2rem;
  }

  .studio-hero__copy {
    align-self: start;
    justify-self: start;
    max-width: 42rem;
    padding-inline: 0.35rem;
  }

  .studio-hero__title {
    margin: 0;
    max-width: 22ch;
    font-size: clamp(1.55rem, 3.2vw, 2.35rem);
    font-weight: 550;
    line-height: 1.12;
    letter-spacing: -0.035em;
    color: rgba(255, 255, 255, 0.94);
    text-wrap: balance;
  }

  .studio-hero__aside {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: end;
    justify-self: start;
    gap: 1.1rem;
    max-width: 25rem;
    padding-inline: 0.35rem;
  }

  .studio-hero__desc {
    margin: 0;
    padding-inline-start: 1rem;
    border-inline-start: 1px solid rgba(255, 255, 255, 0.28);
    color: rgba(255, 255, 255, 0.82);
    font-size: 0.92rem;
    line-height: 1.7;
  }

  @keyframes studio-drift {
    from {
      transform: scale(1.025) translate3d(0, 0, 0);
    }
    to {
      transform: scale(1.075) translate3d(-1.2%, 0.8%, 0);
    }
  }

  @media (min-width: 768px) {
    .studio-hero__content {
      padding: 1.9rem 1.85rem 2.25rem;
    }
  }

  @media (min-width: 1024px) {
    .studio-hero__aside {
      justify-self: end;
    }
  }

  @media (max-width: 639.9px) {
    .studio-hero__stage {
      min-height: 40rem;
      border-radius: 1.5rem;
    }

    .studio-hero__content {
      padding: 1.35rem 1.1rem 1.5rem;
    }

    .studio-hero__aside {
      gap: 0.9rem;
    }

    .studio-hero__desc {
      font-size: 0.88rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .studio-hero__photo {
      animation: none;
      transform: scale(1.02);
    }
  }
</style>
