---
import { FEATURES } from '~/config'
import { withBasePath } from '~/utils/path'
import { parseTuple } from '~/utils/data'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { getLocale, useTranslations } from '~/i18n/translate'

const { search } = FEATURES
if (!search || (Array.isArray(search) && !search[0])) return

const { includes, filter, navHighlight, batchLoadSize, maxItemsPerPage } =
  search[1]
if (includes.length === 0)
  throw new Error(
    "Search feature enabled, but `includes` array is empty. Please check 'src/config.ts' for the correct configuration."
  )
const filterEnabled = filter && includes.length > 1
const batchSize = parseTuple(batchLoadSize, 'batchLoadSize')
const maxItems = parseTuple(maxItemsPerPage, 'maxItemsPerPage')

const locale = getLocale(Astro.currentLocale)
const t = useTranslations(locale)
const localeBase = getRelativeLocaleUrl(locale, '')
const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/'
const localeHomePath = localeBase.replace(/\/+$/, '') || '/'
const isHomeSearch = currentPath === localeHomePath

// 客户端（Custom Element）所需文案，经 data-i18n 注入
const searchPanelI18n = JSON.stringify({
  loading: t('search.loading'),
  loadingHint: t('search.loadingHint'),
  error: t('search.error'),
  errorHint: t('search.errorHint'),
  noResults: t('search.noResults'),
  noResultsHint: t('search.noResultsHint'),
  resultCount: t('search.resultCount'),
  more: t('search.more'),
  all: t('search.all'),
  placeholder: t('search.placeholder'),
  placeholderScoped: t('search.placeholderScoped'),
})
---

<!-- Search Switch -->
<button
  type="button"
  id="search-switch"
  class="touch-target op-60 hover:op-100 op-transition"
  title={t('a11y.search')}
  aria-label={t('a11y.search')}
  aria-controls="search-panel"
  aria-expanded="false"
>
  <div u-i-grommet-icons-search></div>
</button>

<!-- Search Panel -->
<search-panel
  role="dialog"
  id="search-panel"
  class:list={[
    'hidden text-(--c-text) search-panel-studio',
    isHomeSearch ? 'search-panel--home' : 'search-panel--inner',
  ]}
  aria-modal="true"
  aria-labelledby={isHomeSearch ? 'search-label' : 'search-dialog-title'}
  aria-describedby={isHomeSearch ? undefined : 'search-dialog-description'}
  aria-keyshortcuts="ArrowUp,ArrowDown,Enter,Esc"
  data-filter={filterEnabled}
  data-batch-size={batchSize}
  data-max-items={maxItems}
  data-i18n={searchPanelI18n}
  data-state="idle"
  data-has-query="false"
>
  <header class="search-panel__header">
    <div class="search-panel__heading">
      <span class="search-panel__eyebrow">
        <span class="search-panel__eyebrow-dot" aria-hidden="true"></span>
        {t('search.eyebrow')}
      </span>
      <h2 id="search-dialog-title">{t('search.title')}</h2>
      <p id="search-dialog-description">{t('search.description')}</p>
    </div>
    <button
      type="button"
      id="search-close"
      class="search-panel__close touch-target"
      aria-label={t('search.close')}
      title={t('search.close')}
    >
      <span class="search-panel__close-mark" aria-hidden="true">×</span>
    </button>
  </header>

  <div class="search-panel__controls flex flex-col gap-2.5">
    {
      filterEnabled && (
        <div class="search-tabs-shell">
          <span class="search-tabs-label">{t('search.scope')}</span>
          <div
            role="tablist"
            class="search-tabs flex gap-1.5 justify-start items-center"
            aria-label={t('a11y.searchCategories')}
          >
            {includes.map((item) => (
              <button
                type="button"
                role="tab"
                class="search-tabs__tab"
                data-type={item.toLowerCase()}
              >
                {item
                  .split('_')
                  .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
                  .join(' ')}
              </button>
            ))}
          </div>
        </div>
      )
    }
    <div class="search-query">
      <div u-i-grommet-icons-search class="search-query__icon"></div>
      <label for="search-input" id="search-label" class="sr-only">
        {t('a11y.search')}
      </label>
      <input
        type="search"
        role="combobox"
        id="search-input"
        class="search-query__input"
        autocomplete="off"
        autocorrect="off"
        spellcheck="false"
        aria-labelledby="search-label"
        aria-autocomplete="list"
        aria-controls="search-results"
        aria-expanded="false"
      />
      <button
        type="button"
        id="search-clear"
        class="search-query__clear"
        aria-label={t('search.clear')}
        title={t('search.clear')}
      >
        <span aria-hidden="true">×</span>
      </button>
    </div>
  </div>

  <div
    role="listbox"
    id="search-results"
    class="search-results overflow-y-auto"
    aria-labelledby="search-input"
    tabindex="-1"
    data-base={localeBase}
  >
    <div id="search-summary" class="search-summary hidden" aria-live="polite">
    </div>
    <div id="search-empty" class="search-state search-state--empty">
      <div class="search-state__visual" aria-hidden="true">
        <div u-i-grommet-icons-search></div>
      </div>
      <strong>{t('search.emptyTitle')}</strong>
      <span>{t('search.emptyHint')}</span>
    </div>
    <div id="search-content"></div>
    <div
      id="search-feedback"
      class="search-state search-state--feedback hidden"
      role="status"
      aria-live="polite"
    >
      <div class="search-state__visual search-state__visual--pulse" aria-hidden="true">
        <span></span><span></span><span></span>
      </div>
      <strong id="search-feedback-label"></strong>
      <span id="search-feedback-detail"></span>
    </div>
    <div
      id="search-pagination"
      style="display: none"
      class="items-center justify-center gap-3 pt-4 pb-3 text-xs"
    >
      <button
        class="search-pagination__btn"
        data-action="more"
      >
        <div u-i-material-symbols-arrow-cool-down></div>
        <span></span>
      </button>
      <button
        class="search-pagination__btn"
        data-action="all"
      >
        <div u-i-material-symbols-expand-all></div>
        <span></span>
      </button>
    </div>
  </div>

  <footer
    class="search-panel__footer"
    role="note"
    aria-label={t('a11y.keyboardShortcuts')}
  >
    <ul
      class="flex flex-wrap items-center gap-4.5 lt-md:hidden
        pt-3 border-t border-[var(--c-border)]
        text-xs op-45 select-none"
    >
      <li class="flex items-center gap-1.5">
        <kbd class="search-kbd-key">
          <div u-i-material-symbols-arrow-upward></div>
        </kbd>
        <kbd class="search-kbd-key">
          <div u-i-material-symbols-arrow-downward></div>
        </kbd>
        <span>{t('search.navigate')}</span>
      </li>
      <li class="flex items-center gap-1.5">
        <kbd class="search-kbd-key">
          <div u-i-grommet-icons-return></div>
        </kbd>
        <span>{t('search.goToPage')}</span>
      </li>
      <li class="flex items-center gap-1.5">
        <kbd class="search-kbd-key">esc</kbd>
        <span>{t('search.close')}</span>
      </li>
    </ul>
  </footer>
</search-panel>

<style>
  search-panel:not(.hidden) {
    display: grid;
  }

  /* 勿写 position:relative：会压过 fixed，导致面板相对导航偏移到右侧 */
  .search-panel-studio {
    overflow: hidden;
    border: 1px solid var(--c-border);
    border-radius: var(--c-radius-lg);
    background: var(--c-surface);
    box-shadow: var(--c-shadow-hover);
  }

  .search-panel--home,
  .search-panel--inner {
    position: fixed;
    z-index: 200;
    top: 50vh;
    left: 50vw;
    transform: translate(-50%, -50%);
  }

  .search-panel--home {
    width: min(42rem, 90vw);
    max-height: 70vh;
    padding: 0.85rem;
    grid-template-rows: auto 1fr auto;
    gap: 0.65rem;
  }

  .search-panel--inner {
    width: min(40rem, calc(100vw - 2.5rem));
    height: min(42rem, calc(100dvh - 6rem));
    max-height: 42rem;
    padding: 1.25rem 1.35rem 1rem;
    grid-template-rows: auto auto minmax(0, 1fr) auto;
    gap: 1rem;
  }

  .search-panel__header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    min-width: 0;
    padding: 0 0 1rem;
    border-bottom: 1px solid var(--c-border);
  }

  .search-panel__heading {
    min-width: 0;
  }

  .search-panel__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.55rem;
    color: var(--c-muted);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .search-panel__eyebrow-dot {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: currentColor;
  }

  .search-panel__heading h2 {
    margin: 0;
    color: var(--c-text);
    font-size: clamp(1.4rem, 3vw, 1.85rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.03em;
  }

  .search-panel__heading p {
    max-width: 28rem;
    margin: 0.55rem 0 0;
    color: var(--c-muted);
    font-size: 0.9rem;
    line-height: 1.6;
    letter-spacing: -0.01em;
  }

  .search-panel__close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 2.75rem;
    height: 2.75rem;
    margin: -0.35rem -0.35rem 0 0;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--c-muted);
    background: transparent;
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out);
  }

  .search-panel__close:hover,
  .search-panel__close:focus-visible {
    color: var(--c-text);
    background: var(--c-accent-soft);
    border-color: var(--c-border);
    outline: none;
  }

  .search-panel__close-mark {
    font-size: 1.35rem;
    line-height: 1;
  }

  .search-panel__controls {
    min-width: 0;
  }

  .search-tabs-shell {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .search-tabs-label {
    flex: 0 0 auto;
    color: var(--c-muted);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .search-tabs {
    min-width: 0;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .search-tabs__tab {
    flex: 0 0 auto;
    min-height: 2.1rem;
    padding: 0.35rem 0.9rem;
    border: 1px solid transparent;
    border-radius: 999px;
    color: var(--c-muted);
    background: transparent;
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: -0.02em;
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .search-tabs__tab:hover,
  .search-tabs__tab:focus-visible {
    color: var(--c-text);
    background: var(--c-surface-hover);
    outline: none;
  }

  .search-tabs__tab[aria-selected='true'] {
    color: var(--c-text);
    border-color: var(--c-border);
    background: var(--c-bg);
    box-shadow: var(--c-shadow);
  }

  .search-query {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.35rem;
    min-height: 3.25rem;
    padding: 0 0.65rem 0 1rem;
    border: 1px solid var(--c-border);
    border-radius: 999px;
    background: var(--c-bg);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  .search-query:focus-within {
    border-color: color-mix(in srgb, var(--c-accent) 42%, var(--c-border));
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--c-accent) 10%, transparent);
  }

  .search-query__icon {
    color: var(--c-muted);
    opacity: 0.7;
  }

  .search-query__input {
    min-width: 0;
    width: 100%;
    height: 3.15rem;
    padding: 0 0.5rem;
    border: 0;
    color: var(--c-text);
    background: transparent;
    font-size: 1rem;
    letter-spacing: -0.01em;
    outline: none;
  }

  .search-query__clear {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 999px;
    color: var(--c-muted);
    background: transparent;
    font-size: 1.15rem;
    line-height: 1;
    cursor: pointer;
    transition:
      opacity var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out);
  }

  .search-query__clear:hover,
  .search-query__clear:focus-visible {
    color: var(--c-text);
    background: var(--c-accent-soft);
    outline: none;
  }

  .search-panel--inner[data-has-query='false'] .search-query__clear,
  .search-panel--home[data-has-query='false'] .search-query__clear {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .search-results {
    min-height: 0;
    margin: 0;
    padding: 0.15rem 0.1rem;
    border: 0;
    background: transparent;
    scroll-padding-block: 3rem 1rem;
  }

  .search-summary {
    position: sticky;
    z-index: 2;
    top: 0;
    padding: 0.55rem 0.85rem;
    margin-bottom: 0.25rem;
    border-radius: var(--c-radius-sm);
    color: var(--c-muted);
    background: color-mix(in srgb, var(--c-surface) 92%, var(--c-bg));
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .search-state {
    min-height: 100%;
    padding: 3rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: var(--c-muted);
    text-align: center;
  }

  /*
   * 状态可见性必须在组件内显式声明：否则下方的 display:flex 会覆盖
   * 全局 .hidden，导致空状态与 loading/results 同时渲染。
   */
  .search-panel--inner .search-state.hidden,
  .search-panel--inner[data-has-query='true'] .search-state--empty,
  .search-panel--inner:not([data-state='idle']) .search-state--empty,
  .search-panel--inner:is([data-state='idle'], [data-state='results'])
    .search-state--feedback {
    display: none;
  }

  .search-state strong {
    margin-top: 1rem;
    color: var(--c-text);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .search-state > span {
    max-width: 24rem;
    margin-top: 0.4rem;
    font-size: 0.86rem;
    line-height: 1.6;
  }

  .search-state__visual {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.75rem;
    height: 3.75rem;
    border: 1px solid var(--c-border);
    border-radius: 999px;
    color: var(--c-muted);
    background: var(--c-bg);
  }

  .search-state__visual--pulse {
    gap: 0.35rem;
  }

  .search-state__visual--pulse span {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: currentColor;
    opacity: 0.35;
  }

  .search-panel--inner:is(
      [data-state='loading'],
      [data-state='loading-more']
    )
    .search-state__visual--pulse
    span {
    animation: search-pulse 0.9s ease-in-out infinite alternate;
  }

  .search-panel--inner:is(
      [data-state='loading'],
      [data-state='loading-more']
    )
    .search-state__visual--pulse
    span:nth-child(2) {
    animation-delay: 0.14s;
  }

  .search-panel--inner:is(
      [data-state='loading'],
      [data-state='loading-more']
    )
    .search-state__visual--pulse
    span:nth-child(3) {
    animation-delay: 0.28s;
  }

  .search-panel--inner[data-state='loading-more'] .search-state--feedback {
    min-height: auto;
    padding: 0.85rem;
    flex-direction: row;
    gap: 0.65rem;
  }

  .search-panel--inner[data-state='loading-more']
    .search-state--feedback
    .search-state__visual {
    width: 2.25rem;
    height: 2.25rem;
  }

  .search-panel--inner[data-state='loading-more']
    .search-state--feedback
    strong {
    margin-top: 0;
  }

  .search-panel--inner[data-state='loading-more'] #search-feedback-detail {
    display: none;
  }

  .search-panel--inner[data-state='error'] .search-state__visual {
    color: var(--c-text);
    border-color: color-mix(in srgb, var(--c-accent) 28%, var(--c-border));
    background: var(--c-accent-soft);
  }

  .search-pagination__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    min-height: 2.35rem;
    padding: 0.4rem 0.85rem;
    border: 1px solid var(--c-border);
    border-radius: 999px;
    color: var(--c-muted);
    background: var(--c-bg);
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-out),
      background var(--duration-fast) var(--ease-out),
      border-color var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .search-pagination__btn:hover,
  .search-pagination__btn:focus-visible {
    color: var(--c-text);
    background: var(--c-accent-soft);
    border-color: color-mix(in srgb, var(--c-accent) 30%, var(--c-border));
    transform: translateY(-1px);
    outline: none;
  }

  .search-panel__footer {
    min-height: 1.9rem;
  }

  .search-panel__footer :global(ul) {
    margin: 0;
  }

  .search-panel--home .search-panel__header,
  .search-panel--home .search-state--empty,
  .search-panel--home .search-state__visual,
  .search-panel--home #search-feedback-detail,
  .search-panel--home .search-summary {
    display: none !important;
  }

  .search-panel--home :global(.search-result-route) {
    display: none;
  }

  .search-panel--home .search-tabs-shell {
    display: block;
    padding: 0;
  }

  .search-panel--home .search-tabs-label {
    display: none;
  }

  .search-panel--home .search-query {
    min-height: 2.75rem;
  }

  .search-panel--home .search-query__input {
    height: 2.65rem;
    font-size: 0.95rem;
  }

  .search-panel--home .search-results {
    min-height: 0;
    margin: 0.15rem 0;
    padding: 0;
  }

  .search-panel--home .search-state--feedback {
    min-height: 0;
    padding: 0.75rem;
    display: block;
    font-size: 0.875rem;
    opacity: 0.45;
  }

  .search-panel--home .search-state--feedback.hidden {
    display: none;
  }

  .search-panel--home .search-state--feedback strong {
    margin: 0;
    color: inherit;
    font-size: inherit;
    font-weight: inherit;
  }

  .search-panel--home .search-panel__footer {
    min-height: 0;
  }

  @keyframes search-pulse {
    from {
      transform: scale(0.7);
      opacity: 0.25;
    }
    to {
      transform: scale(1);
      opacity: 0.9;
    }
  }

  @media (max-width: 639.9px) {
    .search-panel--inner {
      top: max(0.75rem, env(safe-area-inset-top, 0px));
      right: auto;
      bottom: auto;
      left: 50vw;
      width: calc(
        100vw - 1.5rem - env(safe-area-inset-left, 0px) -
          env(safe-area-inset-right, 0px)
      );
      height: calc(
        100dvh - 1.5rem - env(safe-area-inset-top, 0px) -
          env(safe-area-inset-bottom, 0px)
      );
      max-height: none;
      padding: 1rem 1rem 0.85rem;
      transform: translateX(-50%);
      gap: 0.85rem;
    }

    .search-panel__header {
      gap: 0.65rem;
      padding-bottom: 0.85rem;
    }

    .search-panel__heading p {
      display: none;
    }

    .search-panel__heading h2 {
      font-size: 1.35rem;
    }

    .search-tabs-shell {
      align-items: flex-start;
      gap: 0.45rem;
      flex-direction: column;
    }

    .search-tabs {
      width: 100%;
    }

    .search-query {
      min-height: 3.1rem;
      padding-inline: 0.85rem 0.55rem;
    }

    .search-query__input {
      height: 3rem;
    }

    .search-state {
      padding: 2rem 0.75rem;
    }

    .search-panel__footer {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .search-state__visual--pulse span {
      animation: none !important;
    }

    .search-pagination__btn:hover,
    .search-pagination__btn:focus-visible {
      transform: none;
    }
  }
</style>

<script>
  import '~/components/widgets/search-panel'
</script>


<!-- https://github.com/pagefind/pagefind/blob/production-docs/pagefind_web_js/types/index.d.ts -->
<!-- PROD 由构建产物提供；DEV 依赖 postbuild 同步到 public/pagefind -->
<!-- 默认不急切加载：等打开搜索或 URL 带 ?search= 再拉取（约省 35KB+） -->
<script is:inline define:vars={{scriptUrl: withBasePath('/pagefind/pagefind.js'), navHighlight}}>
  let pagefindPromise = null

  async function loadPagefind() {
    if (window.pagefind) return window.pagefind
    if (pagefindPromise) return pagefindPromise

    pagefindPromise = (async () => {
      try {
        const pagefind = await import(/* @vite-ignore */ scriptUrl)

        // https://pagefind.app/docs/search-config/
        // 索引以 --force-language zh-cn 构建；init 显式指定语言，避免英文页 html[lang=en] 加载失败
        await pagefind.options({
          'excerptLength': 20,
          ...(navHighlight && {
            'highlightParam': 'search'
          }),

          // https://pagefind.app/docs/ranking/
          ranking: {
            termFrequency: 0.6,
            termSimilarity: 1.0,
            pageLength: 0.0,
            termSaturation: 1.4
          }
        })

        await pagefind.init('zh-cn')
        window.pagefind = pagefind
        return pagefind
      } catch (err) {
        // DEV 尚未 build / 未同步索引时静默降级为 mock
        console.warn('[pagefind] unavailable, using mock search results', err)
        pagefindPromise = null
        return null
      }
    })()

    return pagefindPromise
  }

  window.__loadPagefind = loadPagefind

  // 硬导航带 ?search= 时提前装载；SPA 由下方 astro:page-load 处理
  if (navHighlight && new URLSearchParams(location.search).has('search')) {
    loadPagefind()
  }
</script>

{import.meta.env.PROD && navHighlight &&
  <script is:inline define:vars={{scriptUrl: withBasePath('/pagefind/pagefind-highlight.js')}}>
    let highlightPromise = null

    async function loadPagefindHighlight() {
      if (window.pagefindHighlight) return window.pagefindHighlight
      if (highlightPromise) return highlightPromise

      highlightPromise = (async () => {
        await import(scriptUrl)

        const PagefindHighlight = window.PagefindHighlight
        if (!PagefindHighlight) return null
        const pagefindHighlight = new PagefindHighlight({
          // https://pagefind.app/docs/highlight-config
          highlightParam: "search",
          markContext: "[data-pagefind-body]",
          markOptions: {
            // https://markjs.io/#mark
            className: "pagefind-highlight",
            exclude: ["[data-pagefind-ignore]", "[data-pagefind-ignore] *"],
          },
          addStyles: false,
        });

        window.pagefindHighlight = pagefindHighlight
        return pagefindHighlight
      })()

      return highlightPromise
    }

    window.__loadPagefindHighlight = loadPagefindHighlight

    // 硬导航带 ?search= 时提前装载；SPA 由下方 astro:page-load 处理
    if (new URLSearchParams(location.search).has('search')) {
      loadPagefindHighlight()
    }
  </script>}

{import.meta.env.PROD && navHighlight &&
  <script>
    document.addEventListener('astro:page-load', async () => {
      const params = new URLSearchParams(location.search)
      if (!params.has('search')) return

      // View Transitions 后内联脚本不会重跑，须在此按需装载再高亮
      interface HighlightApi {
        highlight: () => void
      }
      const w = window as Window & {
        __loadPagefind?: () => Promise<unknown>
        __loadPagefindHighlight?: () => Promise<HighlightApi | null | undefined>
      }
      await w.__loadPagefind?.()
      const pagefindHighlight = await w.__loadPagefindHighlight?.()
      pagefindHighlight?.highlight()
    })
  </script>}
