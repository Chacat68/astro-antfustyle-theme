<script>
  import '~/components/widgets/search-panel'
</script>


<!-- https://github.com/pagefind/pagefind/blob/production-docs/pagefind_web_js/types/index.d.ts -->
<!-- PROD 由构建产物提供；DEV 依赖 postbuild 同步到 public/pagefind -->
<!-- 默认不急切加载：等打开搜索或 URL 带 ?search= 再拉取（约省 35KB+） -->
<script is:inline define:vars={{scriptUrl: withBasePath('/pagefind/pagefind.js'), navHighlight}}>
  let pagefindPromise = null

  async function loadPagefind() {
    if (window.pagefind) return window.pagefind
    if (pagefindPromise) return pagefindPromise

    pagefindPromise = (async () => {
      try {
        const pagefind = await import(/* @vite-ignore */ scriptUrl)

        // https://pagefind.app/docs/search-config/
        // 索引以 --force-language zh-cn 构建；init 显式指定语言，避免英文页 html[lang=en] 加载失败
        await pagefind.options({
          'excerptLength': 20,
          ...(navHighlight && {
            'highlightParam': 'search'
          }),

          // https://pagefind.app/docs/ranking/
          ranking: {
            termFrequency: 0.6,
            termSimilarity: 1.0,
            pageLength: 0.0,
            termSaturation: 1.4
          }
        })

        await pagefind.init('zh-cn')
        window.pagefind = pagefind
        return pagefind
      } catch (err) {
        // DEV 尚未 build / 未同步索引时静默降级为 mock
        console.warn('[pagefind] unavailable, using mock search results', err)
        pagefindPromise = null
        return null
      }
    })()

    return pagefindPromise
  }

  window.__loadPagefind = loadPagefind

  // 硬导航带 ?search= 时提前装载；SPA 由下方 astro:page-load 处理
  if (navHighlight && new URLSearchParams(location.search).has('search')) {
    loadPagefind()
  }
</script>

{import.meta.env.PROD && navHighlight &&
  <script is:inline define:vars={{scriptUrl: withBasePath('/pagefind/pagefind-highlight.js')}}>
    let highlightPromise = null

    async function loadPagefindHighlight() {
      if (window.pagefindHighlight) return window.pagefindHighlight
      if (highlightPromise) return highlightPromise

      highlightPromise = (async () => {
        await import(scriptUrl)

        const PagefindHighlight = window.PagefindHighlight
        if (!PagefindHighlight) return null
        const pagefindHighlight = new PagefindHighlight({
          // https://pagefind.app/docs/highlight-config
          highlightParam: "search",
          markContext: "[data-pagefind-body]",
          markOptions: {
            // https://markjs.io/#mark
            className: "pagefind-highlight",
            exclude: ["[data-pagefind-ignore]", "[data-pagefind-ignore] *"],
          },
          addStyles: false,
        });

        window.pagefindHighlight = pagefindHighlight
        return pagefindHighlight
      })()

      return highlightPromise
    }

    window.__loadPagefindHighlight = loadPagefindHighlight

    // 硬导航带 ?search= 时提前装载；SPA 由下方 astro:page-load 处理
    if (new URLSearchParams(location.search).has('search')) {
      loadPagefindHighlight()
    }
  </script>}

{import.meta.env.PROD && navHighlight &&
  <script>
    document.addEventListener('astro:page-load', async () => {
      const params = new URLSearchParams(location.search)
      if (!params.has('search')) return

      // View Transitions 后内联脚本不会重跑，须在此按需装载再高亮
      interface HighlightApi {
        highlight: () => void
      }
      const w = window as Window & {
        __loadPagefind?: () => Promise<unknown>
        __loadPagefindHighlight?: () => Promise<HighlightApi | null | undefined>
      }
      await w.__loadPagefind?.()
      const pagefindHighlight = await w.__loadPagefindHighlight?.()
      pagefindHighlight?.highlight()
    })
  </script>}
