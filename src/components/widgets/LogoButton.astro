---
/**
 * 导航左上角品牌字标（Studio 风格）
 * 简洁字标 + 轻微 hover 上浮，对齐胶囊导航对比色
 */
import Link from '~/components/base/Link.astro'
import { ensureTrailingSlash } from '~/utils/path'
import { SITE } from '~/config'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { getLocale } from '~/i18n/translate'

const locale = getLocale(Astro.currentLocale)
const homeHref = ensureTrailingSlash(getRelativeLocaleUrl(locale, ''))
const word = SITE.title
---

<Link
  class="logo-link select-none op-100! hover:op-100"
  href={homeHref}
  aria-label={SITE.author}
  aria-current={ensureTrailingSlash(Astro.url.pathname) === homeHref
    ? 'page'
    : false}
>
  <span class="logo">
    <span class="logo-word">{word}</span>
    <sup class="logo-sup" aria-hidden="true">z</sup>
  </span>
</Link>

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.15rem;
    padding: 0.2rem 0.15rem;
  }

  .logo-word {
    display: block;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: inherit;
    transition: transform var(--duration-fast, 160ms) var(--ease-out, ease);
  }

  .logo-sup {
    font-size: 0.62rem;
    font-weight: 500;
    line-height: 1;
    letter-spacing: 0;
    opacity: 0.55;
  }

  .logo-link:hover .logo-word,
  .logo-link:focus-visible .logo-word {
    transform: translateY(-1px);
  }

  .logo-link:focus-visible {
    outline: 1px solid color-mix(in srgb, currentColor 55%, transparent);
    outline-offset: 4px;
    border-radius: 999px;
  }

  @media (max-width: 767.9px) {
    .logo-word {
      font-size: 0.98rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-word {
      transition: none;
    }

    .logo-link:hover .logo-word,
    .logo-link:focus-visible .logo-word {
      transform: none;
    }
  }
</style>
