---
/**
 * 导航品牌字标：纯文本，无徽标/底色
 */
import Link from '~/components/base/Link.astro'
import { ensureTrailingSlash } from '~/utils/path'
import { SITE } from '~/config'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { getLocale } from '~/i18n/translate'

const locale = getLocale(Astro.currentLocale)
const homeHref = ensureTrailingSlash(getRelativeLocaleUrl(locale, ''))
const word = SITE.title
---

<Link
  class="logo-link select-none"
  href={homeHref}
  aria-label={SITE.title}
  aria-current={ensureTrailingSlash(Astro.url.pathname) === homeHref
    ? 'page'
    : undefined}
>
  <span class="logo-word">{word}</span>
</Link>

<style is:global>
  .site-nav__shell a.logo-link {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.1rem;
    color: var(--c-nav-fg);
    text-decoration: none;
    opacity: 1 !important;
    background: transparent !important;
    background-color: transparent !important;
    box-shadow: none !important;
    border-radius: 0;
    transform: none;
  }

  .site-nav__shell a.logo-link:hover,
  .site-nav__shell a.logo-link:focus-visible,
  .site-nav__shell a.logo-link[aria-current='page'] {
    background: transparent !important;
    background-color: transparent !important;
    box-shadow: none !important;
    transform: none;
  }

  .site-nav__shell .logo-word {
    display: block;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
    letter-spacing: 0.02em;
    white-space: nowrap;
    color: inherit;
    background: transparent;
    transition: opacity var(--duration-fast, 160ms) var(--ease-out, ease);
  }

  .site-nav__shell a.logo-link:hover .logo-word,
  .site-nav__shell a.logo-link:focus-visible .logo-word {
    opacity: 0.78;
  }

  .site-nav__shell a.logo-link:focus-visible {
    outline: 1px solid color-mix(in srgb, currentColor 55%, transparent);
    outline-offset: 4px;
  }

  @media (max-width: 379.9px) {
    .site-nav__shell .logo-word {
      font-size: 0.92rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav__shell .logo-word {
      transition: none;
    }
  }
</style>
