---
import Link from '~/components/base/Link.astro'
import { ensureTrailingSlash } from '~/utils/path'
import { getLocale, useTranslations } from '~/i18n/translate'

const pathSegments = ensureTrailingSlash(Astro.url.pathname)
  .split('/')
  .slice(0, -2)
const href = pathSegments.length > 1 ? pathSegments.join('/') + '/' : '/'
const locale = getLocale(Astro.currentLocale)
const t = useTranslations(locale)
---

<Link class="page-action-link page-action-link--back op-100!" {href}>
  <span aria-hidden="true">←</span>
  <span>{t('footer.back')}</span>
  <span class="page-action-link__hint" aria-hidden="true">cd ..</span>
</Link>
