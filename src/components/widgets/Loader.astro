---
interface Props {
  style?: string
  class?: string
}

const { style, class: className } = Astro.props
---

<div
  {style}
  class={`flex items-center justify-center gap-3 h-full w-full ${className}`}
>
  <div
    class="loader-dot w-4 h-4 rounded-full animate-[dot-pulse_1.5s_ease-in-out_both_infinite]"
  >
  </div>
  <div
    class="loader-dot w-4 h-4 rounded-full animate-[dot-pulse_1.5s_ease-in-out_both_infinite_0.16s]"
  >
  </div>
  <div
    class="loader-dot w-4 h-4 rounded-full animate-[dot-pulse_1.5s_ease-in-out_both_infinite_0.32s]"
  >
  </div>
</div>

<style>
  .loader-dot {
    background: color-mix(in srgb, var(--c-accent) 45%, var(--c-border));
  }

  @keyframes dot-pulse {
    0%,
    80%,
    100% {
      transform: scale(0);
    }
    40% {
      transform: scale(1);
    }
  }
</style>
