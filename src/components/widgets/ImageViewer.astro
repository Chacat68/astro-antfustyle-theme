---
import type Viewer from 'viewerjs'
// CSS 以 URL 传入，首次点击时再注入，避免首页/文章首屏急切拉取
import viewerCssHref from 'viewerjs/dist/viewer.css?url'

interface Props {
  selector: string
  options?: Viewer.Options
  asyncInsert?: boolean
  tabFocus?: boolean
}

const {
  selector,
  options,
  asyncInsert = false,
  tabFocus = false,
} = Astro.props as Props
---

<image-viewer
  data-selector={selector}
  data-options={JSON.stringify(options)}
  data-css-href={viewerCssHref}
  data-async-insert={asyncInsert ? '' : undefined}
  data-tab-focus={tabFocus ? '' : undefined}
>
</image-viewer>

<script>
  import { lockScroll, unlockScroll } from '~/utils/misc'
  import type Viewer from 'viewerjs'

  type ViewerCtor = typeof Viewer

  function isZoomableImage(image: HTMLImageElement) {
    return (
      !image.classList.contains('no-zoom') &&
      image.parentNode?.nodeName !== 'A' &&
      image.parentNode?.parentNode?.nodeName !== 'A'
    )
  }

  export class ImageViewer extends HTMLElement {
    #viewer: InstanceType<ViewerCtor> | null = null
    #ViewerCtor: ViewerCtor | null = null
    #loadPromise: Promise<ViewerCtor> | null = null
    #mutationObserver: MutationObserver | null = null
    #lastViewedImage: HTMLImageElement | null = null
    #container: HTMLElement | null = null
    #onPointerDown: ((event: Event) => void) | null = null
    #cssInjected = false

    connectedCallback() {
      const selector = this.dataset.selector || 'img'
      const container = document.querySelector(selector) as HTMLElement | null
      if (!container) return
      this.#container = container

      this.#onPointerDown = (event: Event) => {
        const target = event.target
        if (!(target instanceof Element)) return
        const img = target.closest('img')
        if (!(img instanceof HTMLImageElement)) return
        if (!container.contains(img) || !isZoomableImage(img)) return

        // 首次交互再装库；阻止默认以免与后续 viewer 抢事件
        event.preventDefault()
        void this.#open(img)
      }

      container.addEventListener('click', this.#onPointerDown)

      if (this.hasAttribute('data-async-insert')) {
        this.#mutationObserver = new MutationObserver(() => {
          this.#viewer?.update()
        })
        this.#mutationObserver.observe(container, { childList: true })
      }
    }

    disconnectedCallback() {
      if (this.#onPointerDown && this.#container) {
        this.#container.removeEventListener('click', this.#onPointerDown)
      }
      this.#onPointerDown = null
      this.#container = null

      if (this.#mutationObserver) {
        this.#mutationObserver.disconnect()
        this.#mutationObserver = null
      }

      if (this.#viewer) {
        this.#viewer.destroy()
        this.#viewer = null
      }
    }

    #injectCss() {
      if (this.#cssInjected) return
      const href = this.dataset.cssHref
      if (!href) return
      if (document.querySelector(`link[data-viewer-css="${href}"]`)) {
        this.#cssInjected = true
        return
      }
      const link = document.createElement('link')
      link.rel = 'stylesheet'
      link.href = href
      link.dataset.viewerCss = href
      document.head.appendChild(link)
      this.#cssInjected = true
    }

    async #ensureViewerCtor() {
      if (this.#ViewerCtor) return this.#ViewerCtor
      if (!this.#loadPromise) {
        this.#loadPromise = (async () => {
          this.#injectCss()
          const mod = await import('viewerjs')
          const ViewerCtor = mod.default
          ViewerCtor.setDefaults({
            button: false,
            navbar: 2,
            title: [
              2,
              (img: HTMLImageElement) => {
                const fn = img.src.split('/').pop()?.split(/[?#]/)[0]
                return img.alt && img.alt !== fn ? img.alt : ''
              },
            ],
            toolbar: false,
            container: 'image-viewer',
            initialCoverage: 1,
            transition: false,
            zIndexInline: 300,
            filter: isZoomableImage,
          })
          this.#ViewerCtor = ViewerCtor
          return ViewerCtor
        })()
      }
      return this.#loadPromise
    }

    async #open(img: HTMLImageElement) {
      const container = this.#container
      if (!container) return

      const ViewerCtor = await this.#ensureViewerCtor()

      let userOptions: Viewer.Options = {}
      try {
        if (this.dataset.options) userOptions = JSON.parse(this.dataset.options)
      } catch (err) {
        console.error('[ImageViewer] Failed to parse options:', err)
      }

      if (!this.#viewer) {
        this.#viewer = new ViewerCtor(container, {
          ...userOptions,
          ...(this.hasAttribute('data-tab-focus') && {
            viewed: ({
              detail,
            }: {
              detail: { originalImage: HTMLImageElement }
            }) => {
              this.#lastViewedImage = detail.originalImage
            },
            hidden: () => {
              if (this.#lastViewedImage) {
                const el = this.#lastViewedImage.parentNode
                if (el?.nodeName === 'FIGURE') {
                  requestAnimationFrame(() => (el as HTMLElement)?.focus())
                }
                requestAnimationFrame(() => this.#lastViewedImage?.focus())
                this.#lastViewedImage = null
              }
            },
          }),
        })

        // https://github.com/fengyuanchen/viewerjs/issues/197
        // @ts-expect-error Viewer 内部 open/close 可替换以同步滚动锁
        this.#viewer.open = function () {
          lockScroll()
        }
        // @ts-expect-error Viewer 内部 open/close 可替换以同步滚动锁
        this.#viewer.close = function () {
          unlockScroll()
        }
      } else {
        this.#viewer.update()
      }

      const images = Array.from(container.querySelectorAll('img')).filter(
        (el): el is HTMLImageElement =>
          el instanceof HTMLImageElement && isZoomableImage(el)
      )
      const index = images.indexOf(img)
      if (index >= 0) this.#viewer.view(index)
    }
  }

  if (!customElements.get('image-viewer'))
    customElements.define('image-viewer', ImageViewer)
</script>
