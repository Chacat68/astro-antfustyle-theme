---
import Link from '~/components/base/Link.astro'
import { UI } from '~/config'

export interface GroupItemData {
  id: string
  link: string
  desc: string
  icon?: string
  avatar?: string
}

interface Props {
  items: GroupItemData[]
}

const { items } = Astro.props
const { showGroupItemColorOnHover } = UI.groupView
---

<div class="group-grid">
  {
    items.map((item) => (
      <Link
        class="group-card"
        href={item.link}
        external={true}
      >
        <div class="group-card__media">
          {item.avatar ? (
            <img src={item.avatar} alt={item.id} class="group-card__avatar" />
          ) : (
            <div
              class:list={[
                'group-card__icon',
                item.icon || 'i-ph-user-circle-duotone',
                showGroupItemColorOnHover && 'group-card__icon--color-on-hover',
              ]}
            />
          )}
        </div>
        <div class="group-card__copy">
          <div class="group-card__title">{item.id}</div>
          <div class="group-card__desc">{item.desc}</div>
        </div>
      </Link>
    ))
  }
</div>

<style>
  /* 与 .studio-page 内容轨同宽；列数由 auto-fill + 最小卡宽决定 */
  .group-grid {
    display: grid;
    grid-template-columns: repeat(
      auto-fill,
      minmax(min(100%, 17.5rem), 1fr)
    );
    gap: 0.85rem;
    width: 100%;
    max-width: none;
    margin: 0.5rem 0 0;
    padding: 0.5rem 0 1.5rem;
  }

  .group-card {
    display: flex;
    align-items: center;
    gap: 0.95rem;
    padding: 1rem 1.05rem;
    border: 1px solid var(--c-border);
    border-radius: var(--c-radius-lg);
    background: var(--c-surface);
    color: var(--c-text) !important;
    opacity: 1 !important;
    text-decoration: none;
    box-shadow: var(--c-shadow);
    transition:
      transform var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease-out),
      background-color var(--duration) var(--ease-out),
      box-shadow var(--duration) var(--ease-out);
  }

  .group-card:hover,
  .group-card:focus-visible {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--c-accent) 22%, var(--c-border));
    background: color-mix(in srgb, var(--c-surface) 80%, var(--c-accent-soft));
    box-shadow: var(--c-shadow-hover);
    outline: none;
  }

  .group-card__media {
    flex: 0 0 auto;
  }

  .group-card__avatar {
    width: 3rem;
    height: 3rem;
    border-radius: 999px;
    object-fit: cover;
  }

  .group-card__icon {
    font-size: 1.85rem;
    line-height: 1;
    opacity: 0.72;
    filter: saturate(0);
    transition:
      opacity var(--duration) var(--ease-out),
      filter var(--duration) var(--ease-out);
  }

  .group-card:hover .group-card__icon--color-on-hover,
  .group-card:focus-visible .group-card__icon--color-on-hover {
    opacity: 1;
    filter: saturate(1);
  }

  .group-card__copy {
    min-width: 0;
  }

  .group-card__title {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .group-card__desc {
    margin-top: 0.2rem;
    color: var(--c-muted);
    font-size: 0.875rem;
    line-height: 1.45;
  }
</style>
