---
import { getCollection } from 'astro:content'

import CardItem from '~/components/views/CardItem.astro'
import Warning from '~/components/base/Warning.astro'
import { getFilteredPosts, getShortsFromBlog } from '~/utils/data'
import { getLocale, useTranslations } from '~/i18n/translate'
import { ensureTrailingSlash } from '~/utils/path'
import { getRelativeLocaleUrl } from 'astro:i18n'

interface Props {
  collectionType?: 'blog' | 'shorts'
  gap?: number
  minCardWidth?: number
  maxCardWidth?: number
}

const {
  collectionType = 'blog',
  gap = 16,
  minCardWidth,
  maxCardWidth,
} = Astro.props

const locale = getLocale(Astro.currentLocale)
const t = useTranslations(locale)
const WARNING = t('warning.noContentHtml', { file: 'CardView.astro' })

const dataForGrid =
  collectionType === 'shorts'
    ? (await getFilteredPosts('shorts'))
        .sort((a, b) => b.data.pubDate!.valueOf() - a.data.pubDate!.valueOf())
        .map((post) => ({
          link:
            post.data.redirect ||
            ensureTrailingSlash(
              getRelativeLocaleUrl(locale, `shorts/${post.id}`)
            ),
          text: post.data.title,
          date: post.data.pubDate,
        }))
    : getShortsFromBlog(await getCollection('blog'))
---

{
  dataForGrid.length === 0 ? (
    <Warning html={WARNING} />
  ) : (
    <div
      class="grid w-full fade-in"
      style={{
        '--fade-in-duration': '0.6s',
        'gap': `${gap}px`,
        'grid-template-columns': `repeat(auto-fill, minmax(min(100%, ${minCardWidth ? `${minCardWidth}px` : '220px'}), ${maxCardWidth ? `${maxCardWidth}px` : '1fr'}))`,
      }}
    >
      {dataForGrid.map((item) => (
        <CardItem class="card-grid min-h-40 lt-md:min-h-0" item={item} />
      ))}
    </div>
  )
}
