---
import { Image } from 'astro:assets'

import Link from '~/components/base/Link.astro'
import ImageCarousel from '~/components/widgets/ImageCarousel.astro'
import { formatDate } from '~/utils/datetime'
import { sanitizeHtml } from '~/utils/sanitize-html'
import { getLocale } from '~/i18n/translate'
import { localeToHtmlLang } from '~/i18n/locale-meta'

import type { ImageMetadata } from 'astro'
import type { HTMLAttributes } from 'astro/types'
import type { LocalImageProps, RemoteImageProps } from 'astro:assets'

interface ImageData {
  src: string
  alt: string
}

interface VideoData {
  src: string
  alt: string
  poster: string
}

interface ExternalData {
  uri: string
  title: string
  description: string
  img: string
}

interface QuoteData {
  uri: string
  text: string
  author: {
    link: string
    avatar: string
    name: string
    handle: string
  }
}

export interface CardItemData {
  date?: Date | string
  text?: string
  html?: string
  link?: string
  images?: ImageData[]
  video?: VideoData
  external?: ExternalData
  quote?: QuoteData
  details?: string[]
}

interface Props {
  item: CardItemData
  imageProps?:
    | ({ src: ImageMetadata } & LocalImageProps)
    | ({ src: string; inferSize?: true } & RemoteImageProps)
  videoProps?: HTMLAttributes<'video'>
  class?: string
}

const { item, imageProps, videoProps, class: className } = Astro.props

const COMPACT = false
const MAX_DETAILS = 3

const { date, text, html, link, images, video, external, quote, details } = item

const safeHtml = html ? sanitizeHtml(html) : undefined
const safeDetails = details?.map((detail) => sanitizeHtml(detail))

const MediaContainer = link ? Link : 'div'
const ContentContainer = safeDetails
  ? 'collapsible-content'
  : link && text && !safeHtml
    ? Link
    : 'div'

let proccessedImages: { src: string | ImageMetadata; alt: string }[] = []
if (images && images.length > 0) {
  if (images.some((image) => !image.src.startsWith('http'))) {
    const localImages = import.meta.glob<{ default: ImageMetadata }>(
      '/src/assets/**/*.{jpg,jpeg,png,webp,avif}'
    )

    proccessedImages = await Promise.all(
      images.map(async (image) => {
        if (!image.src.startsWith('http') && !localImages[image.src])
          throw new Error(
            `"${image.src}" does not exist in glob: "/src/assets/**/*.{jpg,jpeg,png,webp,avif}"`
          )

        return {
          src: image.src.startsWith('http')
            ? image.src
            : (await localImages[image.src]()).default,
          alt: image.alt,
        }
      })
    )
  } else {
    proccessedImages = images
  }
}

const locale = getLocale(Astro.currentLocale)
const dateLocale = localeToHtmlLang(locale)
const expandDetailsLabel = locale === 'zh' ? '展开详情' : 'Expand details'
const collapseDetailsLabel = locale === 'zh' ? '收起详情' : 'Collapse details'
const mediaLinkLabel =
  link && video
    ? video.alt || (locale === 'zh' ? '查看媒体' : 'View media')
    : undefined
---

<section class={className}>
  <div class="card-hud hud-cut relative overflow-hidden flex flex-col h-full">
    <span class="hud-corner hud-corner--tl card-hud__corner" aria-hidden="true"
    ></span>
    <span class="hud-corner hud-corner--br card-hud__corner" aria-hidden="true"
    ></span>
    {
      ((images && images.length > 0) || video) && (
        <MediaContainer
          class="card-hud__media op-100!"
          href={link || undefined}
          aria-label={mediaLinkLabel}
        >
          {images &&
            (images.length > 1 ? (
              <ImageCarousel
                images={proccessedImages}
                imageProps={imageProps}
              />
            ) : (
              // @ts-expect-error(ignore)
              <Image
                class="aspect-16/9 object-cover"
                src={proccessedImages[0].src}
                alt={images[0].alt}
                {...(typeof images[0].src === 'string'
                  ? { width: 1600, height: 900 }
                  : {})}
                {...imageProps}
              />
            ))}

          {video && (
            <video
              class="w-full aspect-16/9 object-cover"
              src={video.src}
              poster={video.poster}
              aria-label={video.alt}
              autoplay
              muted
              loop
              playsinline
              {...videoProps}
            />
          )}
        </MediaContainer>
      )
    }
    {
      external && (
        <Link
          class={`card-hud__subcard hud-cut overflow-hidden flex flex-col
            mt-3 mx-3 op-100!`}
          href={external.uri}
        >
          {!COMPACT && external.img && (
            <Image
              class="card-hud__divider aspect-[1.91/1] object-cover"
              src={external.img}
              alt={external.title}
              width={1200}
              height={628}
              {...imageProps}
            />
          )}
          <div class="flex flex-col px-3 pt-2 pb-1">
            <div class="card-hud__divider flex flex-col gap-1 pb-1.5">
              <p class="text-sm font-600">{external.title}</p>
              <p class="text-xs">{external.description}</p>
            </div>
            <div class="flex items-center gap-1 pt-1 text-[0.72rem] op-70">
              <div u-i-hugeicons-earth class="size-1em" aria-hidden="true" />
              <p>{new URL(external.uri).hostname}</p>
            </div>
          </div>
        </Link>
      )
    }
    {
      quote && (
        <div
          class={`card-hud__subcard hud-cut overflow-hidden flex flex-col gap-2
            p-2 mt-3 mx-3 text-sm`}
        >
          <div class="flex items-center gap-1">
            <Image
              class="size-1em rounded-full object-cover"
              src={quote.author.avatar}
              alt={quote.author.name}
              width={64}
              height={64}
              widths={[64]}
              sizes="1em"
            />
            <p class="truncate">
              <span class="font-600">{quote.author.name}</span>
              <Link class="op-transition" href={quote.author.link}>
                {`@${quote.author.handle}`}
              </Link>
            </p>
          </div>
          <Link class="op-80!" href={quote.uri}>
            <p class="line-height-normal">{quote.text}</p>
          </Link>
        </div>
      )
    }
    <ContentContainer
      class="flex flex-col justify-between h-full p-4 pb-3 op-100!"
      href={link || undefined}
    >
      {
        Astro.slots.has('default') && (
          <div class="prose card-item-prose">
            <slot />
          </div>
        )
      }
      {safeHtml && <div class="prose card-item-prose" set:html={safeHtml} />}
      {text && <p class="prose card-item-prose">{text}</p>}
      {
        safeDetails && (
          <div
            class="card-item-details"
            style="max-height: 0; overflow-y: clip;"
          >
            <ol class="card-hud__timeline relative">
              {safeDetails.slice(0, MAX_DETAILS + 1).map((detail, idx) => (
                <li class="ms-4 mb-6 last:mb-0">
                  <div class="card-hud__dot absolute start--1.6 w-2.5 h-2.5 mt-1.5" />
                  {idx < MAX_DETAILS && (
                    <div class="prose card-item-prose" set:html={detail} />
                  )}
                  {link && idx === MAX_DETAILS && (
                    <Link class="prose card-item-prose op-100!" href={link}>
                      View more...
                    </Link>
                  )}
                </li>
              ))}
            </ol>
          </div>
        )
      }
      {
        date && (
          <div class="card-hud__foot flex justify-between items-center pt-3 text-sm">
            {link && safeHtml ? (
              <Link class="flex-auto op-transition" href={link}>
                {formatDate(date, true, false, dateLocale)}
              </Link>
            ) : (
              <p class="op-60">{formatDate(date, true, false, dateLocale)}</p>
            )}
            {safeDetails && (
              <button
                type="button"
                class="details-switch op-50 op-transition hover:op-100"
                aria-label={expandDetailsLabel}
                title={expandDetailsLabel}
                aria-expanded="false"
                data-expand-label={expandDetailsLabel}
                data-collapse-label={collapseDetailsLabel}
              >
                <div
                  u-i-famicons-chevron-down-sharp
                  class="icon-down"
                  aria-hidden="true"
                />
                <div
                  u-i-famicons-chevron-up-sharp
                  class="icon-up hidden"
                  aria-hidden="true"
                />
              </button>
            )}
          </div>
        )
      }
    </ContentContainer>
  </div>
</section>

<style>
  /* HUD 卡壳：取代原先的 white/black 卡 + #8884 边 */
  .card-hud {
    border: 1px solid color-mix(in srgb, var(--c-accent) 20%, var(--c-border));
    background: var(--c-surface);
    box-shadow: var(--c-shadow);
    transition:
      border-color var(--duration) var(--ease-out),
      background-color var(--duration) var(--ease-out),
      box-shadow var(--duration) var(--ease-out),
      transform var(--duration) var(--ease-out);
  }

  .card-hud:hover,
  .card-hud:focus-within {
    border-color: color-mix(in srgb, var(--c-accent) 45%, var(--c-border));
    background: color-mix(
      in srgb,
      var(--c-surface-hover) 40%,
      var(--c-surface)
    );
    transform: translateY(-2px);
    box-shadow:
      -2px 0 0 color-mix(in srgb, var(--c-glitch-red) 40%, transparent),
      2px 0 0 color-mix(in srgb, var(--c-glitch-cyan) 40%, transparent),
      var(--c-shadow-hover);
  }

  /* 四角括号仅在 grid（/shorts）常显；masonry 卡图多，避免压在照片上 */
  .card-hud__corner {
    display: none;
  }

  .card-grid .card-hud__corner {
    display: block;
  }

  .card-hud__media,
  .card-hud__divider {
    border-bottom: 1px solid var(--c-border);
  }

  .card-hud__subcard {
    border: 1px solid var(--c-border);
    background: color-mix(in srgb, var(--c-bg) 55%, transparent);
    transition:
      border-color var(--duration) var(--ease-out),
      background-color var(--duration) var(--ease-out);
  }

  .card-hud__subcard:hover {
    border-color: color-mix(in srgb, var(--c-accent) 35%, var(--c-border));
    background: var(--c-accent-soft);
  }

  .card-hud__timeline {
    border-inline-start: 1px solid var(--c-border);
  }

  .card-hud__dot {
    border: 1px solid color-mix(in srgb, var(--c-accent) 55%, transparent);
    background: color-mix(in srgb, var(--c-accent) 30%, var(--c-bg));
  }

  .card-hud__foot {
    border-top: 1px solid color-mix(in srgb, var(--c-border) 60%, transparent);
    margin-top: 0.75rem;
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.05em;
  }

  @media (prefers-reduced-motion: reduce) {
    .card-hud:hover,
    .card-hud:focus-within {
      transform: none;
    }
  }
</style>

<script>
  class CollapsibleContent extends HTMLElement {
    #isExpanded = false
    #detailsContainer: HTMLElement | null = null
    #button: HTMLButtonElement | null = null
    #upIcon: HTMLElement | null = null
    #downIcon: HTMLElement | null = null
    #handleClick: (() => void) | null = null

    connectedCallback() {
      this.#detailsContainer = this.querySelector('.card-item-details')
      this.#button = this.querySelector('.details-switch')
      this.#downIcon = this.querySelector('.icon-down')
      this.#upIcon = this.querySelector('.icon-up')

      this.#isExpanded = false
      this.#syncButtonState()
      this.#setupEventListeners()
    }

    disconnectedCallback() {
      this.#cleanup()
    }

    #setupEventListeners = () => {
      if (!this.#button) return

      this.#handleClick = () => {
        if (!this.#detailsContainer || !this.#upIcon || !this.#downIcon) return

        this.#isExpanded = !this.#isExpanded

        if (this.#isExpanded) {
          this.#detailsContainer.style.marginTop = '1.1rem'
          this.#detailsContainer.style.maxHeight = `${this.#detailsContainer.scrollHeight}px`
          this.#upIcon.classList.remove('hidden')
          this.#downIcon.classList.add('hidden')
        } else {
          this.#detailsContainer.style.marginTop = '0'
          this.#detailsContainer.style.maxHeight = '0'
          this.#upIcon.classList.add('hidden')
          this.#downIcon.classList.remove('hidden')
        }
        this.#syncButtonState()
      }

      this.#button.addEventListener('click', this.#handleClick)
    }

    #syncButtonState = () => {
      if (!this.#button) return
      const label = this.#isExpanded
        ? this.#button.dataset.collapseLabel
        : this.#button.dataset.expandLabel
      this.#button.setAttribute(
        'aria-expanded',
        this.#isExpanded ? 'true' : 'false'
      )
      if (label) {
        this.#button.setAttribute('aria-label', label)
        this.#button.title = label
      }
    }

    #cleanup = () => {
      if (this.#button && this.#handleClick) {
        this.#button.removeEventListener('click', this.#handleClick)
        this.#handleClick = null
      }
    }
  }

  customElements.define('collapsible-content', CollapsibleContent)
</script>
