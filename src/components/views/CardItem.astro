---
import { Image } from 'astro:assets'

import Link from '~/components/base/Link.astro'
import ImageCarousel from '~/components/widgets/ImageCarousel.astro'
import { formatDate } from '~/utils/datetime'
import { sanitizeHtml } from '~/utils/sanitize-html'
import { getLocale, useTranslations } from '~/i18n/translate'
import { localeToHtmlLang } from '~/i18n/locale-meta'

import type { ImageMetadata } from 'astro'
import type { HTMLAttributes } from 'astro/types'
import type { LocalImageProps, RemoteImageProps } from 'astro:assets'

interface ImageData {
  src: string
  alt: string
}

interface VideoData {
  src: string
  alt: string
  poster: string
}

interface ExternalData {
  uri: string
  title: string
  description: string
  img: string
}

interface QuoteData {
  uri: string
  text: string
  author: {
    link: string
    avatar: string
    name: string
    handle: string
  }
}

export interface CardItemData {
  date?: Date | string
  text?: string
  html?: string
  link?: string
  images?: ImageData[]
  video?: VideoData
  external?: ExternalData
  quote?: QuoteData
  details?: string[]
}

interface Props {
  item: CardItemData
  imageProps?:
    | ({ src: ImageMetadata } & LocalImageProps)
    | ({ src: string; inferSize?: true } & RemoteImageProps)
  videoProps?: HTMLAttributes<'video'>
  class?: string
}

const { item, imageProps, videoProps, class: className } = Astro.props

const COMPACT = false
const MAX_DETAILS = 3

const { date, text, html, link, images, video, external, quote, details } = item

const safeHtml = html ? sanitizeHtml(html) : undefined
const safeDetails = details?.length
  ? details.map((detail) => sanitizeHtml(detail))
  : undefined

let externalHostname = ''
if (external?.uri) {
  try {
    externalHostname = new URL(external.uri, Astro.url).hostname
  } catch {
    // 无效链接仍交给 Link 原样渲染，但不能让主机名展示中断整页构建。
  }
}

const MediaContainer = link ? Link : 'div'
const ContentContainer = safeDetails
  ? 'collapsible-content'
  : link && text && !safeHtml
    ? Link
    : 'div'

let proccessedImages: { src: string | ImageMetadata; alt: string }[] = []
if (images && images.length > 0) {
  if (images.some((image) => !image.src.startsWith('http'))) {
    const localImages = import.meta.glob<{ default: ImageMetadata }>(
      '/src/assets/**/*.{jpg,jpeg,png,webp,avif}'
    )

    proccessedImages = await Promise.all(
      images.map(async (image) => {
        if (!image.src.startsWith('http') && !localImages[image.src])
          throw new Error(
            `"${image.src}" does not exist in glob: "/src/assets/**/*.{jpg,jpeg,png,webp,avif}"`
          )

        return {
          src: image.src.startsWith('http')
            ? image.src
            : (await localImages[image.src]()).default,
          alt: image.alt,
        }
      })
    )
  } else {
    proccessedImages = images
  }
}

const locale = getLocale(Astro.currentLocale)
const t = useTranslations(locale)
const dateLocale = localeToHtmlLang(locale)
---

<section class:list={['studio-card-wrap', className]}>
  <div class="studio-card overflow-hidden flex flex-col h-full">
    {
      ((images && images.length > 0) || video) && (
        <MediaContainer
          class="studio-card__media op-100!"
          href={link || undefined}
        >
          {images &&
            (images.length > 1 ? (
              <ImageCarousel
                images={proccessedImages}
                imageProps={imageProps}
              />
            ) : (
              // @ts-expect-error(ignore)
              <Image
                class="aspect-16/9 object-cover"
                src={proccessedImages[0].src}
                alt={images[0].alt}
                {...(typeof images[0].src === 'string'
                  ? { width: 1600, height: 900 }
                  : {})}
                {...imageProps}
              />
            ))}

          {video && (
            <video
              class="w-full aspect-16/9 object-cover"
              src={video.src}
              poster={video.poster}
              aria-label={video.alt}
              autoplay
              muted
              loop
              playsinline
              {...videoProps}
            />
          )}
        </MediaContainer>
      )
    }
    {
      external && (
        <Link
          class="studio-card__embed overflow-hidden flex flex-col mt-3 mx-3 op-100!"
          href={external.uri}
        >
          {!COMPACT && external.img && (
            <Image
              class="studio-card__media aspect-[1.91/1] object-cover"
              src={external.img}
              alt={external.title}
              width={1200}
              height={628}
              {...imageProps}
            />
          )}
          <div class="flex flex-col px-3 pt-2 pb-1">
            <div class="studio-card__embed-head flex flex-col gap-1 pb-1.5">
              <p class="text-sm font-600">{external.title}</p>
              <p class="text-xs">{external.description}</p>
            </div>
            <div class="flex items-center gap-1 pt-1 text-[0.72rem] op-70">
              <div u-i-hugeicons-earth class="size-1em" aria-hidden="true" />
              {externalHostname && <p>{externalHostname}</p>}
            </div>
          </div>
        </Link>
      )
    }
    {
      quote && (
        <div class="studio-card__embed overflow-hidden flex flex-col gap-2 p-2 mt-3 mx-3 text-sm">
          <div class="flex items-center gap-1">
            <Image
              class="size-1em rounded-full object-cover"
              src={quote.author.avatar}
              alt={quote.author.name}
              width={64}
              height={64}
              widths={[64]}
              sizes="1em"
            />
            <p class="truncate">
              <span class="font-600">{quote.author.name}</span>
              <Link class="op-transition" href={quote.author.link}>
                {`@${quote.author.handle}`}
              </Link>
            </p>
          </div>
          <Link class="op-80!" href={quote.uri}>
            <p class="line-height-normal">{quote.text}</p>
          </Link>
        </div>
      )
    }
    <ContentContainer
      class="flex flex-col justify-between h-full p-4 pb-3 op-100!"
      href={link || undefined}
    >
      {
        Astro.slots.has('default') && (
          <div class="prose card-item-prose">
            <slot />
          </div>
        )
      }
      {safeHtml && <div class="prose card-item-prose" set:html={safeHtml} />}
      {text && <p class="prose card-item-prose">{text}</p>}
      {
        safeDetails && (
          <div
            class="card-item-details"
            style="max-height: 0; overflow-y: clip;"
            aria-hidden="true"
            inert
          >
            <ol class="studio-card__timeline relative">
              {safeDetails.slice(0, MAX_DETAILS + 1).map((detail, idx) => (
                <li class="ms-4 mb-6 last:mb-0">
                  <div class="studio-card__dot absolute start--1.6 w-3 h-3 mt-1.5" />
                  {idx < MAX_DETAILS && (
                    <div class="prose card-item-prose" set:html={detail} />
                  )}
                  {link && idx === MAX_DETAILS && (
                    <Link class="prose card-item-prose op-100!" href={link}>
                      View more...
                    </Link>
                  )}
                </li>
              ))}
            </ol>
          </div>
        )
      }
      {
        (date || safeDetails) && (
          <div class="flex justify-between items-center pt-3 text-sm">
            {date &&
              (link && safeHtml ? (
                <Link class="flex-auto op-transition" href={link}>
                  {formatDate(date, true, false, dateLocale)}
                </Link>
              ) : (
                <p class="op-60">{formatDate(date, true, false, dateLocale)}</p>
              ))}
            {safeDetails && (
              <button
                type="button"
                class="details-switch op-50 op-transition hover:op-100"
                aria-expanded="false"
                aria-label={t('a11y.expandDetails')}
                data-label-expand={t('a11y.expandDetails')}
                data-label-collapse={t('a11y.collapseDetails')}
              >
                <div
                  u-i-famicons-chevron-down-sharp
                  class="icon-down"
                  aria-hidden="true"
                />
                <div
                  u-i-famicons-chevron-up-sharp
                  class="icon-up hidden"
                  aria-hidden="true"
                />
              </button>
            )}
          </div>
        )
      }
    </ContentContainer>
  </div>
</section>

<style>
  .studio-card {
    border: 1px solid var(--c-border);
    border-radius: var(--c-radius-lg);
    background: var(--c-surface);
    box-shadow: var(--c-shadow);
    transition:
      transform var(--duration) var(--ease-out),
      border-color var(--duration) var(--ease-out),
      box-shadow var(--duration) var(--ease-out);
  }

  .studio-card-wrap:hover .studio-card,
  .studio-card-wrap:focus-within .studio-card {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--c-accent) 18%, var(--c-border));
    box-shadow: var(--c-shadow-hover);
  }

  .studio-card__media {
    border-bottom: 1px solid var(--c-border);
  }

  .studio-card__embed {
    border: 1px solid var(--c-border);
    border-radius: var(--c-radius);
    background: color-mix(in srgb, var(--c-bg) 55%, transparent);
    transition: box-shadow var(--duration) var(--ease-out);
  }

  .studio-card__embed:hover,
  .studio-card__embed:focus-visible {
    box-shadow: var(--c-shadow);
    outline: none;
  }

  .studio-card__embed-head {
    border-bottom: 1px solid var(--c-border);
  }

  .studio-card__timeline {
    border-inline-start: 1px solid var(--c-border);
  }

  .studio-card__dot {
    border: 1px solid var(--c-surface);
    border-radius: 999px;
    background: color-mix(in srgb, var(--c-muted) 45%, var(--c-surface));
  }
</style>

<script>
  class CollapsibleContent extends HTMLElement {
    #isExpanded = false
    #detailsContainer: HTMLElement | null = null
    #button: HTMLButtonElement | null = null
    #upIcon: HTMLElement | null = null
    #downIcon: HTMLElement | null = null
    #handleClick: (() => void) | null = null

    connectedCallback() {
      this.#detailsContainer = this.querySelector('.card-item-details')
      this.#button = this.querySelector<HTMLButtonElement>('.details-switch')
      this.#downIcon = this.querySelector('.icon-down')
      this.#upIcon = this.querySelector('.icon-up')

      this.#isExpanded = false
      this.#setupEventListeners()
    }

    disconnectedCallback() {
      this.#cleanup()
    }

    #setupEventListeners = () => {
      if (!this.#button) return

      this.#handleClick = () => {
        if (!this.#detailsContainer || !this.#upIcon || !this.#downIcon) return

        this.#isExpanded = !this.#isExpanded

        if (this.#isExpanded) {
          this.#detailsContainer.removeAttribute('inert')
          this.#detailsContainer.setAttribute('aria-hidden', 'false')
          this.#detailsContainer.style.marginTop = '1.1rem'
          this.#detailsContainer.style.maxHeight = `${this.#detailsContainer.scrollHeight}px`
          this.#button?.setAttribute('aria-expanded', 'true')
          this.#button?.setAttribute(
            'aria-label',
            this.#button.dataset.labelCollapse || 'Collapse details'
          )
          this.#upIcon.classList.remove('hidden')
          this.#downIcon.classList.add('hidden')
        } else {
          this.#detailsContainer.setAttribute('inert', '')
          this.#detailsContainer.setAttribute('aria-hidden', 'true')
          this.#detailsContainer.style.marginTop = '0'
          this.#detailsContainer.style.maxHeight = '0'
          this.#button?.setAttribute('aria-expanded', 'false')
          this.#button?.setAttribute(
            'aria-label',
            this.#button.dataset.labelExpand || 'Expand details'
          )
          this.#upIcon.classList.add('hidden')
          this.#downIcon.classList.remove('hidden')
        }
      }

      this.#button.addEventListener('click', this.#handleClick)
    }

    #cleanup = () => {
      if (this.#button && this.#handleClick) {
        this.#button.removeEventListener('click', this.#handleClick)
        this.#handleClick = null
      }
    }
  }

  customElements.define('collapsible-content', CollapsibleContent)
</script>
