---
import Link from '~/components/base/Link.astro'

import { ensureTrailingSlash } from '~/utils/path'
import { formatDate } from '~/utils/datetime'
import { getRelativeLocaleUrl } from 'astro:i18n'
import { getLocale, useTranslations } from '~/i18n/translate'
import { localeToHtmlLang } from '~/i18n/locale-meta'

interface Props {
  idx: number
  collectionType: string
  redirect?: string
  postSlug?: string
  title: string
  video?: boolean
  radio?: boolean
  date: string | Date
  minutesRead?: number
  platform?: string
}

const {
  idx,
  redirect,
  collectionType,
  postSlug,
  title,
  video,
  radio,
  date,
  minutesRead,
  platform,
} = Astro.props

const locale = getLocale(Astro.currentLocale)
const t = useTranslations(locale)
const dateLocale = localeToHtmlLang(locale)

const internalHref = ensureTrailingSlash(
  getRelativeLocaleUrl(locale, `${collectionType}/${postSlug ?? ''}`)
)
---

<div class="slide-enter" style={{ '--enter-stage': idx }}>
  <Link
    class="list-item-link border-b-none! op-transition!"
    href={redirect ?? internalHref}
    external={redirect ? true : false}
    enableNewTabWarning={redirect ? true : false}
  >
    <span class="list-item-link__index" aria-hidden="true">
      {String(idx + 1).padStart(2, '0')}
    </span>
    <span class="list-item-link__title">{title}</span>
    <span class="list-item-link__meta">
      {
        video && (
          <span
            u-i-ri-film-line
            class="flex-none op-50 align-middle"
            title={t('list.video')}
            aria-label={t('list.video')}
          />
        )
      }
      {
        radio && (
          <span
            u-i-ri-radio-line
            class="flex-none op-50 align-middle"
            title={t('list.radio')}
            aria-label={t('list.radio')}
          />
        )
      }
      <time
        class="op-50 text-sm ws-nowrap font-mono tracking-wide"
        datetime={new Date(date).toISOString()}
      >
        {formatDate(date, false, false, dateLocale)}
      </time>
      {
        typeof minutesRead === 'number' && minutesRead > 0 && (
          <span class="op-40 text-sm ws-nowrap">
            · {minutesRead} {t('post.min')}
          </span>
        )
      }
      {platform && <span class="op-40 text-sm ws-nowrap">· {platform}</span>}
    </span>
  </Link>
</div>

<style>
  .list-item-link {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto;
    gap: 0.8rem;
    align-items: center;
  }

  .list-item-link__index {
    color: color-mix(in srgb, var(--c-accent) 72%, var(--c-muted));
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
  }

  .list-item-link__index::before {
    content: '[';
    opacity: 0.45;
  }

  .list-item-link__index::after {
    content: ']';
    opacity: 0.45;
  }

  .list-item-link__title {
    min-width: 0;
    color: var(--fg-deeper, var(--c-text));
    font-size: 1.02rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .list-item-link__meta {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    justify-content: flex-end;
    color: var(--c-muted);
  }

  .list-item-link::after {
    content: '↗';
    position: absolute;
    top: 50%;
    right: 0.7rem;
    color: var(--c-accent);
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.75rem;
    opacity: 0;
    transform: translate(-0.4rem, -50%);
    transition:
      opacity var(--duration-fast) var(--ease-out),
      transform var(--duration-fast) var(--ease-out);
  }

  .list-item-link:hover::after,
  .list-item-link:focus-visible::after {
    opacity: 0.75;
    transform: translate(0, -50%);
  }

  @media (max-width: 767.9px) {
    .list-item-link {
      grid-template-columns: 1.8rem minmax(0, 1fr);
      gap: 0.3rem 0.55rem;
    }

    .list-item-link__meta {
      grid-column: 2;
      justify-content: flex-start;
      flex-wrap: wrap;
    }

    .list-item-link::after {
      display: none;
    }
  }
</style>
