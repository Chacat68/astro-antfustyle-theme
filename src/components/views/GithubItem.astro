---
import Link from '~/components/base/Link.astro'
import { formatDate } from '~/utils/datetime'
import { sanitizeHtml } from '~/utils/sanitize-html'
import { getLocale } from '~/i18n/translate'
import { localeToHtmlLang } from '~/i18n/locale-meta'

import type { ExtendedReleaseData, ExtendedPrData } from './GithubView.astro'

type Props =
  | {
      collectionType: 'releases'
      idx: number
      item: ExtendedReleaseData
      isDiffMonth: boolean
    }
  | {
      collectionType: 'prs'
      idx: number
      item: ExtendedPrData
      isDiffMonth: boolean
    }

const { collectionType, idx, item, isDiffMonth } = Astro.props

const locale = getLocale(Astro.currentLocale)
const dateLocale = localeToHtmlLang(locale)

const isOrg =
  collectionType === 'releases'
    ? item.repoIsInOrganization
    : item.repository.isInOrganization

const mainLogoSrc = item.mainLogo
const mainLogoAlt =
  collectionType === 'releases'
    ? item.repoNameWithOwner
    : item.repository.nameWithOwner
const subLogoSrc = item.subLogo

const firstLinkHref = item.url
const firstLinkText = collectionType === 'releases' ? item.pkgName : item.title

const secondLinkHref =
  collectionType === 'releases' ? item.repoUrl : item.repository.url
const secondLinkText =
  collectionType === 'releases'
    ? item.repoNameWithOwner
    : item.repository.nameWithOwner

const time = collectionType === 'releases' ? item.publishedAt : item.createdAt
const content = sanitizeHtml(
  collectionType === 'releases' ? item.descriptionHTML : item.bodyHTML
)
---

<details
  class={`github-item slide-enter flex flex-col ${isDiffMonth ? 'mt-12 lt-sm:mt-10' : ''}`}
  style={{ '--enter-stage': idx }}
>
  {/* Logo */}
  <summary
    class="github-item__summary flex items-center gap-4 lt-sm:gap-2 cursor-pointer"
  >
    <div class="flex-none relative">
      <img
        class={`github-item__logo size-11 lt-sm:size-10 mt-0.2
            ${isOrg ? 'rounded-[var(--c-radius)]' : 'rounded-full transform-scale-108'}`}
        src={mainLogoSrc}
        alt={mainLogoAlt}
      />
      {
        subLogoSrc && (
          <div
            class={`github-item__sublogo absolute bottom--2 right--1.6
              flex justify-center items-center size-6 p-0.72 rounded-full`}
          >
            {subLogoSrc.includes('://') ? (
              <img src={subLogoSrc} alt="Sub logo" />
            ) : (
              <span class={subLogoSrc} />
            )}
          </div>
        )
      }
    </div>

    {/* Text */}
    <div class="flex-1 flex justify-between items-center gap-2 min-w-0">
      <div class="flex flex-col gap-0.5 min-w-0">
        <Link
          class="flex items-center gap-1.5 op-100! text-4.4 lt-sm:text-3.9 hover:underline"
          href={firstLinkHref}
          external={true}
        >
          {
            collectionType === 'prs' &&
              (item.state === 'MERGED' ? (
                <span
                  u-i-bx-git-merge
                  class="github-item__state github-item__state--merged size-4.5 lt-sm:size-4 shrink-0"
                />
              ) : (
                <span
                  u-i-bx-git-pull-request
                  class="github-item__state github-item__state--open size-4.5 lt-sm:size-4 shrink-0"
                />
              ))
          }
          <span class="truncate">{firstLinkText}</span>
        </Link>
        <div class="flex items-center text-sm lt-sm:text-3.2 op-transition">
          <Link class="truncate" href={secondLinkHref} external={true}>
            {secondLinkText}
          </Link>
        </div>
      </div>
      <div class="shrink-0 flex flex-col items-end gap-0.6">
        <Link
          class="op-100! font-mono text-4.2 lt-sm:text-3.6 hover:underline"
          href={firstLinkHref}
          external={true}
        >
          {
            collectionType === 'releases' && (
              <span>
                v{item.versionParts[0]}<span class={`github-${item.versionType}`}>{item.versionParts[1]}</span>
              </span>
            )
          }
          {collectionType === 'prs' && (
            <span class="hud-chip">#{item.number}</span>
          )}
        </Link>
        {time && (
          <time
            class="op-60 font-mono text-sm lt-sm:text-3.2 tracking-wide"
            datetime={time}
            title={time}
          >
            {formatDate(time, false, false, dateLocale)}
          </time>
        )}
      </div>
    </div>
  </summary>
  <div class="prose github-item-prose" set:html={content} />
</details>

<style>
  /* 与 .list-item-link 同一手感：斜切 + accent 底 + RGB 双色边 */
  .github-item__summary {
    --hud-cut: 10px;

    padding: 0.5rem 0.7rem;
    border: 1px solid transparent;
    margin-inline: -0.7rem;

    clip-path: polygon(
      0 0,
      calc(100% - var(--hud-cut)) 0,
      100% var(--hud-cut),
      100% 100%,
      var(--hud-cut) 100%,
      0 calc(100% - var(--hud-cut))
    );
    transition:
      border-color var(--duration) var(--ease-out),
      background-color var(--duration) var(--ease-out),
      box-shadow var(--duration) var(--ease-out);
  }

  .github-item__summary:hover,
  .github-item__summary:focus-visible {
    border-color: color-mix(in srgb, var(--c-accent) 35%, var(--c-border));
    background: color-mix(in srgb, var(--c-surface-hover) 65%, var(--c-accent-soft));
    box-shadow:
      -2px 0 0 color-mix(in srgb, var(--c-glitch-red) 40%, transparent),
      2px 0 0 color-mix(in srgb, var(--c-glitch-cyan) 40%, transparent);
  }

  .github-item__logo {
    border: 1px solid var(--c-border);
  }

  .github-item__sublogo {
    border: 1px solid var(--c-border);
    background: color-mix(in srgb, var(--c-bg) 88%, var(--c-surface));
  }

  /* 状态色走 HUD 同族：已合并=accent，待合并=故障青 */
  .github-item__state--merged {
    color: var(--c-accent);
  }

  .github-item__state--open {
    color: var(--c-glitch-cyan);
  }

  @media (max-width: 639.9px) {
    .github-item__summary {
      padding-inline: 0.4rem;
      margin-inline: 0;
    }
  }
</style>
