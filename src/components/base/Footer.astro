---
import Link from '~/components/base/Link.astro'
import { SITE } from '~/config'

const currentYear = new Date().getFullYear()
const copyrightText = `© ${currentYear} ${SITE.author}`
---

<footer class="site-footer slide-enter animate-delay-1600! mt-auto mb-8">
  <div class="site-footer__inner">
    <div class="site-footer__row">
      <span>{copyrightText}</span>
      <span class="site-footer__sep" aria-hidden="true">·</span>
      <span>
        Powered by
        <Link
          class="site-footer__link"
          href="https://github.com/lin-stephanie/astro-antfustyle-theme"
          external={true}
        >
          Astro AntfuStyle Theme
        </Link>
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
    padding-inline: var(--c-rail-pad, 1.25rem);
  }

  .site-footer__inner {
    width: 100%;
    max-width: var(--c-nav-max, 65ch);
    margin-inline: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--c-border);
    color: var(--c-muted);
    font-size: 0.85rem;
  }

  .site-footer__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.55rem;
  }

  .site-footer__sep {
    opacity: 0.55;
  }

  .site-footer__link {
    color: var(--c-text) !important;
    opacity: 0.85 !important;
    border: 0 !important;
  }

  .site-footer__link:hover,
  .site-footer__link:focus-visible {
    opacity: 1 !important;
  }

  @media (max-width: 640px) {
    .site-footer__row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.25rem;
    }

    .site-footer__sep {
      display: none;
    }
  }
</style>
