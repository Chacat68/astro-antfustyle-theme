---
import { slug } from '~/utils/toc'

interface Props {
  idx?: number
  text: string
  needId?: boolean
  wide?: boolean
  showLabel?: boolean
}

const {
  idx,
  text,
  needId = false,
  wide = false,
  showLabel = true,
} = Astro.props

const style: Record<string, string | number> = {}
if (idx !== undefined) style['--enter-stage'] = idx - 2
---

<div
  {...needId ? { id: slug(text) } : {}}
  class:list={[
    'toc-heading categorizer relative',
    wide ? 'categorizer--wide' : 'categorizer--narrow',
    idx !== undefined ? 'slide-enter' : '',
  ]}
  style={Object.keys(style).length !== 0 ? style : undefined}
>
  <span class="categorizer__watermark" aria-hidden="true">{text}</span>
  {
    showLabel ? (
      <span class="categorizer__label">
        <span class="categorizer__label-prefix" aria-hidden="true">
          SECTOR /
        </span>
        <span class="categorizer__label-text">{text}</span>
      </span>
    ) : (
      <span class="sr-only">{text}</span>
    )
  }
</div>

<style>
  /* 分组水印：描边色与 HUD 同色相。
   * 这里不能直接用半透明的 --c-hud-line：它会与下面的 opacity 相乘，水印几乎消失。 */
  .categorizer__watermark {
    position: absolute;

    color: transparent;
    font-weight: 700;
    pointer-events: none;
    user-select: none;

    -webkit-text-stroke-color: color-mix(
      in srgb,
      var(--c-accent) 55%,
      var(--c-text)
    );
  }

  .categorizer--narrow .categorizer__watermark {
    top: -2.5rem;
    left: -3rem;

    font-size: 8em;
    opacity: 0.12;

    -webkit-text-stroke-width: 2px;
  }

  /* 宽模式与 GroupItem 网格共同铺满页面壳，保持标题、分组与卡片同轴。 */
  .categorizer--wide {
    overflow: hidden;
    width: 100%;
  }

  .categorizer--wide .categorizer__watermark {
    top: 0;
    left: 0;

    font-size: 5em;
    line-height: 1em;
    opacity: 0.26;

    -webkit-text-stroke-width: 1.5px;
  }

  :global(:root.dark) .categorizer--narrow .categorizer__watermark {
    opacity: 0.14;
  }

  :global(:root.dark) .categorizer--wide .categorizer__watermark {
    opacity: 0.2;
  }

  /* mono 分组标识：贴在本组首项之上，替代仅靠巨字水印传达分组。
   * 走正常流 + 容器底对齐，避免绝对定位在紧凑列表里压到上一项。 */
  /* 高度写在组件内而非依赖 h-20 工具类：水印是绝对定位的，
   * 容器必须自己占住这段纵向空间，否则流内标签会溢出压到上一项。 */
  .categorizer {
    display: flex;
    align-items: flex-end;
    min-height: 5rem;
  }

  .categorizer__label {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;

    padding-bottom: 0.3rem;

    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
  }

  .categorizer__label-prefix {
    color: color-mix(in srgb, var(--c-accent) 70%, transparent);
  }

  .categorizer__label-text {
    color: var(--c-muted);
    text-transform: uppercase;
  }

  @media (max-width: 639.9px) {
    .categorizer--narrow .categorizer__watermark {
      top: -1.8rem;
      left: -1rem;

      font-size: 5.5em;
    }

    .categorizer--wide .categorizer__watermark {
      top: 0.5rem;

      font-size: 3.6em;
    }
  }

  @media (min-width: 640px) and (max-width: 1023.9px) {
    .categorizer--wide .categorizer__watermark {
      font-size: 4.5em;
    }
  }
</style>
