---
import { slug } from '~/utils/toc'

interface Props {
  idx?: number
  text: string
  needId?: boolean
  wide?: boolean
  showLabel?: boolean
}

const {
  idx,
  text,
  needId = false,
  wide = false,
  showLabel = true,
} = Astro.props

const style: Record<string, string | number> = {}
if (idx !== undefined) style['--enter-stage'] = idx - 2
---

<div
  {...needId ? { id: slug(text) } : {}}
  class:list={[
    'toc-heading categorizer',
    wide ? 'categorizer--wide' : 'categorizer--narrow',
    idx !== undefined ? 'slide-enter' : '',
  ]}
  style={Object.keys(style).length !== 0 ? style : undefined}
>
  {
    showLabel ? (
      <span class="categorizer__label">
        <span class="categorizer__dot" aria-hidden="true" />
        <span class="categorizer__text">{text}</span>
      </span>
    ) : (
      <span class="sr-only">{text}</span>
    )
  }
</div>

<style>
  /* Studio 分组：圆点眉题 + 底部分隔线；无 SECTOR / 水印 / mono 科技前缀 */
  .categorizer {
    display: flex;
    align-items: flex-end;
    min-height: 3.25rem;
    margin-top: 0.5rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--c-border);
  }

  .categorizer--wide {
    width: 100%;
  }

  .categorizer__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--c-muted);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .categorizer__dot {
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: currentColor;
  }

  .categorizer__text {
    color: inherit;
  }

  @media (max-width: 639.9px) {
    .categorizer {
      min-height: 2.75rem;
      padding-bottom: 0.55rem;
    }

    .categorizer__label {
      font-size: 0.72rem;
      letter-spacing: 0.1em;
    }
  }
</style>
